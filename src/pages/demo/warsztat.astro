---
import '@fontsource/oswald/latin-600.css';
import '@fontsource/oswald/latin-ext-600.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-ext-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-ext-600.css';
import DemoLayout from '../../layouts/DemoLayout.astro';
import DemoForm from '../../components/demo/DemoForm.astro';
import DemoMap from '../../components/demo/DemoMap.astro';
import DemoHours from '../../components/demo/DemoHours.astro';

const services = [
  { name: 'Wymiana oleju z filtrem', price: 'od 149 zł', note: 'olej klienta lub nasz' },
  { name: 'Diagnostyka komputerowa', price: '120 zł', note: 'odczyt i opis błędów' },
  { name: 'Wymiana klocków hamulcowych', price: 'od 180 zł', note: 'jedna oś, robocizna' },
  { name: 'Wymiana opon z wyważeniem', price: 'od 100 zł', note: 'komplet 4 kół do 16"' },
  { name: 'Przegląd przed zakupem auta', price: '250 zł', note: 'raport ze zdjęciami' },
  { name: 'Serwis klimatyzacji', price: 'od 199 zł', note: 'odgrzybianie w cenie' },
];
const hours: [string, string][] = [
  ['Poniedziałek – piątek', '7:30 – 17:00'],
  ['Sobota', '8:00 – 13:00'],
  ['Niedziela', 'zamknięte'],
];
const reviews = [
  { text: 'Wycena przed naprawą, bez niespodzianek na fakturze. Auto odebrane tego samego dnia.', who: 'Marek, Passat B7' },
  { text: 'Pokazali mi stare klocki i wytłumaczyli, co było nie tak. Rzadkość.', who: 'Ania, Yaris' },
  { text: 'Szybki termin na diagnostykę i konkretna informacja, co trzeba zrobić teraz, a co może poczekać.', who: 'Tomek, Octavia' },
];
---
<DemoLayout
  title="Tłok & Klucz — warsztat samochodowy (demo) | Gerdzio Koduje"
  description="Strona pokazowa fikcyjnego warsztatu samochodowego Tłok & Klucz. Projekt: Gerdzio Koduje."
  themeColor="#16191c"
  theme="warsztat"
>
  <header class="w-header">
    <div class="d-container w-header__in">
      <a href="#tresc" class="w-logo"><span class="w-logo__mark" aria-hidden="true"></span>Tłok <span>&amp;</span> Klucz</a>
      <nav aria-label="Menu warsztatu">
        <ul>
          <li><a href="#uslugi">Usługi</a></li>
          <li><a href="#o-nas">O nas</a></li>
          <li><a href="#opinie">Opinie</a></li>
          <li><a href="#kontakt">Kontakt</a></li>
        </ul>
      </nav>
      <a class="w-btn w-btn--sm" href="tel:000000000">000 000 000</a>
    </div>
  </header>

  <main id="tresc">
    <section class="w-hero">
      <div class="d-container w-hero__in">
        <p class="w-kicker">Mechanika · Diagnostyka · Opony</p>
        <h1>Naprawiamy auta tak, jakby były nasze.</h1>
        <p class="w-hero__lead">Warsztat w Przykładowie. Najpierw diagnoza i wycena, potem naprawa — dopiero gdy ją zaakceptujesz.</p>
        <div class="w-hero__cta">
          <a class="w-btn" href="#kontakt">Umów wizytę</a>
          <a class="w-btn w-btn--ghost" href="tel:000000000">Zadzwoń: 000 000 000</a>
        </div>
        <ul class="w-usp">
          <li><strong>48 h</strong> termin na diagnostykę</li>
          <li><strong>12 mies.</strong> gwarancji na robociznę</li>
          <li><strong>0 zł</strong> za wycenę naprawy</li>
        </ul>
      </div>
    </section>

    <section id="uslugi" class="d-section">
      <div class="d-container">
        <p class="w-kicker w-kicker--dark">Cennik</p>
        <h2>Usługi i przykładowe ceny</h2>
        <p class="w-sub">Ceny orientacyjne dla aut osobowych. Dokładną kwotę podajemy po oględzinach.</p>
        <ul class="w-services">
          {services.map((s) => (
            <li>
              <h3>{s.name}</h3>
              <p class="w-services__note">{s.note}</p>
              <p class="w-services__price">{s.price}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="o-nas" class="d-section w-about">
      <div class="d-container w-about__in">
        <div class="w-about__img" aria-hidden="true">
          <span>2 stanowiska</span>
          <span>3 mechaników</span>
          <span>od 2009 r.</span>
        </div>
        <div>
          <p class="w-kicker w-kicker--dark">O nas</p>
          <h2>Rodzinny warsztat, nie sieciówka</h2>
          <p>Prowadzimy warsztat od lat w tym samym miejscu. Naprawiamy auta osobowe i dostawcze do 3,5 t wszystkich marek. Każdą wymienioną część możesz zabrać ze sobą — pokazujemy, co i dlaczego zostało wymienione.</p>
          <p>Nie lubimy niespodzianek, więc przed każdą naprawą dzwonimy z wyceną. Jeśli coś może poczekać, powiemy to wprost.</p>
        </div>
      </div>
    </section>

    <section id="opinie" class="d-section">
      <div class="d-container">
        <p class="w-kicker w-kicker--dark">Opinie</p>
        <h2>Co mówią kierowcy <span class="w-tag">przykładowe</span></h2>
        <ul class="w-reviews">
          {reviews.map((r) => (
            <li>
              <p class="w-stars" aria-label="Ocena 5 na 5">★★★★★</p>
              <blockquote><p>„{r.text}”</p></blockquote>
              <p class="w-reviews__who">— {r.who}</p>
            </li>
          ))}
        </ul>
        <p class="w-sub">Opinie przykładowe — firma jest fikcyjna.</p>
      </div>
    </section>

    <section id="kontakt" class="d-section w-contact">
      <div class="d-container w-contact__in">
        <div class="w-contact__info">
          <p class="w-kicker w-kicker--dark">Kontakt</p>
          <h2>Umów wizytę</h2>
          <dl class="w-dl">
            <div><dt>Adres</dt><dd>ul. Przykładowa 1, 00-000 Przykładowo</dd></div>
            <div><dt>Telefon</dt><dd><a href="tel:000000000">000 000 000</a></dd></div>
            <div><dt>E-mail</dt><dd>kontakt@example.com</dd></div>
          </dl>
          <h3 class="w-h3">Godziny otwarcia</h3>
          <DemoHours hours={hours} />
          <DemoMap address="ul. Przykładowa 1, 00-000 Przykładowo" />
        </div>
        <div class="w-card">
          <h3 class="w-h3">Formularz zgłoszenia</h3>
          <DemoForm id="w" services={services.map((s) => s.name).concat('Inna usługa')} submitLabel="Wyślij zgłoszenie" />
        </div>
      </div>
    </section>
  </main>

  <footer class="w-footer">
    <div class="d-container">
      <p><strong>Tłok &amp; Klucz</strong> — firma fikcyjna, dane przykładowe.</p>
      <p>ul. Przykładowa 1, 00-000 Przykładowo · tel. 000 000 000</p>
    </div>
  </footer>
</DemoLayout>

<style is:global>
  .demo--warsztat {
    --d-bg: #f3f2ee;
    --d-text: #16191c;
    --d-muted: #4f555b;
    --d-accent: #f97316;
    --d-link: #b33c0a;
    --d-focus: #b33c0a;
    --d-surface: #ffffff;
    --d-line: #d6d3cb;
    --d-radius: 2px;
    --d-font-head: 'Oswald', 'Arial Narrow', sans-serif;
    --d-font-body: 'Inter', system-ui, sans-serif;
    --d-input-bg: #fff;
    --d-input-border: #8a8f94;
    --d-map-bg: #e4e2dc;
    --d-map-block: #cfccc3;
    --d-map-green: #c8d3bd;
  }
  .demo--warsztat h2 { font-size: clamp(2rem, 1.5rem + 2vw, 3rem); font-weight: 600; text-transform: uppercase; letter-spacing: 0.01em; }
  .demo--warsztat h3 { font-family: 'Inter', sans-serif; font-weight: 600; font-size: 1.05rem; }
  .w-sub { color: var(--d-muted); margin-top: 0.75rem; max-width: 40rem; }
  .w-kicker { font-family: var(--d-font-head); text-transform: uppercase; letter-spacing: 0.15em; font-weight: 600; font-size: 0.85rem; color: var(--d-accent); margin-bottom: 0.75rem; }
  .w-kicker--dark { color: var(--d-link); }
  .w-tag { display: inline-block; vertical-align: middle; font-family: 'Inter', sans-serif; font-size: 0.8rem; text-transform: none; letter-spacing: 0; font-weight: 600; padding: 0.15rem 0.5rem; background: #ffe2cc; color: #7a2a05; border-radius: 2px; }

  .w-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 3rem; padding: 0.7rem 1.4rem; background: var(--d-accent); color: #16191c !important; font-weight: 600; text-decoration: none; border: 2px solid var(--d-accent); border-radius: var(--d-radius); text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.92rem; }
  .w-btn:hover { background: #fb923c; border-color: #fb923c; }
  .w-btn--ghost { background: transparent; color: #fff !important; border-color: #6b7177; }
  .w-btn--ghost:hover { background: transparent; border-color: var(--d-accent); }
  .w-btn--sm { min-height: 2.5rem; padding: 0.4rem 0.9rem; font-size: 0.85rem; }

  .w-header { background: #16191c; color: #fff; border-bottom: 1px solid #2c3136; }
  .w-header__in { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4rem; }
  .w-logo { display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--d-font-head); font-weight: 600; font-size: 1.35rem; text-transform: uppercase; letter-spacing: 0.04em; color: #fff !important; text-decoration: none; }
  .w-logo span { color: var(--d-accent); }
  .w-logo__mark { width: 1.1rem; height: 1.1rem; border: 3px solid var(--d-accent); transform: rotate(45deg); }
  .w-header nav { display: none; }
  .w-header nav ul { list-style: none; display: flex; gap: 1.75rem; padding: 0; }
  .w-header nav a { color: #e6e6e6; text-decoration: none; font-size: 0.92rem; }
  .w-header nav a:hover { color: var(--d-accent); }
  @media (min-width: 52rem) { .w-header nav { display: block; } }

  .w-hero {
    background-color: #16191c;
    background-image: repeating-linear-gradient(135deg, transparent 0 22px, rgba(255,255,255,0.025) 22px 44px);
    color: #fff;
    padding-block: clamp(3.5rem, 2rem + 6vw, 7rem);
  }
  .w-hero h1 { font-size: clamp(2.4rem, 1.6rem + 4vw, 4.6rem); font-weight: 600; text-transform: uppercase; max-width: 16ch; letter-spacing: 0.005em; }
  .w-hero__lead { margin-top: 1.25rem; max-width: 36rem; font-size: 1.1rem; color: #c9cdd1; }
  .w-hero__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .w-usp { list-style: none; padding: 0; margin-top: 3rem; display: grid; gap: 1rem; border-top: 1px solid #2f353b; padding-top: 1.5rem; }
  .w-usp li { color: #c9cdd1; }
  .w-usp strong { display: block; font-family: var(--d-font-head); font-size: 2rem; color: var(--d-accent); font-weight: 600; }
  @media (min-width: 40rem) { .w-usp { grid-template-columns: repeat(3, 1fr); } }

  .w-services { list-style: none; padding: 0; margin-top: 2rem; display: grid; gap: 1px; background: var(--d-line); border: 1px solid var(--d-line); }
  .w-services li { background: var(--d-surface); padding: 1.25rem; display: grid; grid-template-columns: 1fr auto; gap: 0.2rem 1rem; align-items: baseline; }
  .w-services__note { grid-column: 1; color: var(--d-muted); font-size: 0.9rem; }
  .w-services__price { grid-column: 2; grid-row: 1 / span 2; font-family: var(--d-font-head); font-weight: 600; font-size: 1.4rem; white-space: nowrap; }
  @media (min-width: 48rem) { .w-services { grid-template-columns: 1fr 1fr; } }

  .w-about { background: #e8e6e0; }
  .w-about__in { display: grid; gap: 2.5rem; align-items: center; }
  .w-about__in p:not(.w-kicker) { margin-top: 1rem; max-width: 38rem; }
  .w-about__img { display: grid; gap: 1px; background: #16191c; aspect-ratio: 4 / 3; grid-template-rows: 2fr 1fr; grid-template-columns: 1fr 1fr; border-radius: var(--d-radius); overflow: hidden; }
  .w-about__img span { display: grid; place-items: end start; padding: 1rem; background: #23282d; color: #fff; font-family: var(--d-font-head); font-size: 1.3rem; text-transform: uppercase; }
  .w-about__img span:first-child { grid-column: 1 / -1; background: repeating-linear-gradient(135deg, #23282d 0 18px, #2a3036 18px 36px); color: var(--d-accent); font-size: 2rem; }
  @media (min-width: 52rem) { .w-about__in { grid-template-columns: 1fr 1.2fr; } }

  .w-reviews { list-style: none; padding: 0; margin-top: 2rem; display: grid; gap: 1rem; }
  .w-reviews li { background: var(--d-surface); padding: 1.5rem; border-top: 4px solid var(--d-accent); display: grid; gap: 0.75rem; }
  .w-stars { color: #b33c0a; letter-spacing: 0.1em; }
  .w-reviews__who { color: var(--d-muted); font-size: 0.9rem; }
  @media (min-width: 52rem) { .w-reviews { grid-template-columns: repeat(3, 1fr); } }

  .w-contact { background: #e8e6e0; }
  .w-contact__in { display: grid; gap: 2.5rem; }
  .w-contact__info { display: grid; gap: 1.25rem; align-content: start; }
  .w-h3 { margin-bottom: 0.25rem; }
  .w-dl { display: grid; gap: 0.6rem; }
  .w-dl dt { font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--d-muted); }
  .w-card { background: var(--d-surface); padding: clamp(1.25rem, 1rem + 1.5vw, 2rem); border-top: 4px solid var(--d-accent); align-self: start; display: grid; gap: 1rem; }
  .demo--warsztat .d-form .d-btn { justify-self: start; min-height: 3rem; padding: 0.7rem 1.4rem; background: var(--d-accent); color: #16191c; border: 0; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; cursor: pointer; border-radius: var(--d-radius); }
  .demo--warsztat .d-form .d-btn:hover { background: #fb923c; }
  @media (min-width: 60rem) { .w-contact__in { grid-template-columns: 1fr 1.2fr; } }

  .w-footer { background: #16191c; color: #c9cdd1; padding-block: 2rem; font-size: 0.9rem; }
  .w-footer .d-container { display: grid; gap: 0.3rem; }
  .w-footer strong { color: #fff; }
</style>
