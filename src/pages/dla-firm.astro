---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Offer from '../components/home/Offer.astro';
import Portfolio from '../components/home/Portfolio.astro';
import Process from '../components/home/Process.astro';
import About from '../components/home/About.astro';
import Faq from '../components/home/Faq.astro';
import Contact from '../components/home/Contact.astro';
import { packages, formatPrice } from '../config';

const prices = packages
  .filter((p) => p.price !== undefined)
  .map((p) => `${p.name} od ${formatPrice(p.price!)}${p.period ?? ''}`)
  .join(', ')
  .replace(/\.$/, '');
---
<BaseLayout
  title="Strony internetowe dla firm | Gerdzio Koduje"
  description={`Strony internetowe dla lokalnych firm z automatyczną obsługą zapytań. ${prices}, indywidualne wyceny. Makieta w 1–2 dni.`}
>
  <Hero />
  <Offer />
  <Portfolio />
  <Process />
  <About />
  <Faq />
  <Contact />
</BaseLayout>
