---
/** Placeholder mapy — bez embedu Google (szybciej i bez ciasteczek). */
interface Props { address: string }
const { address } = Astro.props;
---
<figure class="d-map">
  <svg viewBox="0 0 400 260" width="400" height="260" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
    <rect width="400" height="260" fill="var(--d-map-bg, #e9e6df)" />
    <g stroke="var(--d-map-road, #fff)" stroke-linecap="round" fill="none">
      <path d="M-10 70 L410 110" stroke-width="18" />
      <path d="M120 -10 L160 270" stroke-width="14" />
      <path d="M-10 200 C120 180 260 230 410 190" stroke-width="10" />
      <path d="M290 -10 L270 270" stroke-width="8" />
      <path d="M20 -10 L60 270" stroke-width="5" />
    </g>
    <rect x="180" y="125" width="70" height="45" rx="4" fill="var(--d-map-block, #d9d4c9)" />
    <rect x="300" y="130" width="70" height="40" rx="4" fill="var(--d-map-block, #d9d4c9)" />
    <rect x="175" y="20" width="90" height="50" rx="4" fill="var(--d-map-green, #cfe0c3)" />
    <g transform="translate(212 98)">
      <path d="M0 0 C-14 -18 -14 -38 0 -40 C14 -38 14 -18 0 0 Z" fill="var(--d-accent)" />
      <circle cx="0" cy="-27" r="5" fill="#fff" />
    </g>
  </svg>
  <figcaption>
    <strong>Mapa — placeholder</strong>
    <span>{address}</span>
  </figcaption>
</figure>

<style is:global>
  .d-map { border-radius: var(--d-radius, 6px); overflow: hidden; border: 1px solid var(--d-line, #ddd); background: var(--d-surface); }
  .d-map svg { width: 100%; height: auto; aspect-ratio: 400 / 260; }
  .d-map figcaption { display: grid; gap: 0.1rem; padding: 0.8rem 1rem; font-size: 0.92rem; }
  .d-map figcaption span { color: var(--d-muted); }
</style>
