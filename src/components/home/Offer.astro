---
import { packages, formatPrice } from '../../config';
---
<section id="oferta" class="section" aria-labelledby="oferta-title">
  <div class="container">
    <div class="section-head">
      <h2 id="oferta-title">Oferta dla firm</h2>
      <p>Ceny „od” — dokładną wycenę dostajesz po krótkim briefie. Domena zawsze rejestrowana na Ciebie.</p>
    </div>

    <ul class="packages">
      {packages.map((p) => (
        <li class:list={['pkg', { 'pkg--featured': p.featured, 'pkg--custom': p.price === undefined }]}>
          <div class="pkg__top">
            <h3 class="pkg__name">{p.name}</h3>
            {p.badge && <p class="pkg__badge">{p.badge}</p>}
          </div>
          {p.price !== undefined ? (
            <p class="pkg__price">
              <span class="pkg__from">od</span>
              <span class="pkg__amount"><strong>{formatPrice(p.price)}</strong>{p.period && <span class="pkg__period">{p.period}</span>}</span>
            </p>
          ) : (
            <p class="pkg__price">
              <span class="pkg__from">cena</span>
              <span class="pkg__amount pkg__amount--custom"><strong>{p.priceLabel ?? 'Wycena indywidualna'}</strong></span>
            </p>
          )}
          <p class="pkg__summary">{p.summary}</p>
          <ul class="check-list pkg__features">
            {p.features.map((f) => <li>{f}</li>)}
          </ul>
          <a href="#kontakt" class:list={['btn', 'btn--block', { 'btn--secondary': !p.featured }]} data-package={p.inForm ? p.name : undefined}>
            {p.cta ?? 'Zapytaj o ten pakiet'}<span class="visually-hidden">: {p.name}</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="offer-note">
      Robię strony dla firm. Jeśli chcesz nauczyć się budować sam — zajrzyj do sekcji <a href="/nauka">Nauka</a>.
    </p>
  </div>
</section>

<style>
  .packages { list-style: none; padding: 0; display: grid; gap: 1.25rem; }
  .pkg {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .pkg--featured { background: var(--accent-tint); border-color: var(--accent-line); }
  .pkg__top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; }
  .pkg__name { font-size: var(--step-1); }
  .pkg__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: rgba(34, 224, 122, 0.12);
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 800;
  }
  .pkg__badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .pkg__price { display: grid; gap: 0.35rem; }
  .pkg__from { font-size: var(--step--1); }
  .pkg__amount { display: flex; align-items: baseline; gap: 0.4rem; white-space: nowrap; }
  .pkg__price strong { font-size: clamp(1.9rem, 1.5rem + 1.2vw, 2.5rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1; }
  .pkg__from, .pkg__period { color: var(--text-muted); }
  .pkg__summary { color: var(--text-muted); padding-bottom: 1.1rem; border-bottom: 1px solid var(--border); }
  .pkg--featured .pkg__summary { border-color: var(--accent-line); }
  .pkg__features { margin-bottom: 0.75rem; }
  .pkg__amount--custom strong { font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem); letter-spacing: -0.03em; }
  .pkg--custom { background: var(--bg); border-style: dashed; border-color: var(--border-strong); }
  .pkg--custom:hover { border-color: var(--accent-line); }
  .pkg .btn { margin-top: auto; }
  .offer-note { margin-top: 2.5rem; color: var(--text-muted); max-width: 46rem; }
  @media (min-width: 44rem) {
    .packages { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 72rem) {
    .packages { grid-template-columns: repeat(4, 1fr); gap: 1rem; }
    .pkg { padding: 1.6rem; }
    .pkg .btn { font-size: var(--step--1); padding-inline: 1rem; }
  }
</style>
