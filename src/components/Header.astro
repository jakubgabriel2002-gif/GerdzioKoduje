---
import Lockup from './Lockup.astro';
import { nav } from '../config';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand">
      <Lockup size="sm" /><span class="visually-hidden"> — strona główna</span>
    </a>

    <div class="site-header__actions">
      <a href="/aplikacje" class="apps-link" aria-current={path === '/aplikacje' ? 'page' : undefined}>
        <span class="apps-link__icon" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        Aplikacje
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span class="menu-toggle__icon" aria-hidden="true"><span></span></span>
        <span class="menu-toggle__label">menu</span>
      </button>
    </div>

    <nav id="site-nav" class="site-nav" aria-label="Główna nawigacja">
      <ul class="site-nav__list">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      <a href="/dla-firm#kontakt" class="btn btn--sm site-nav__cta">Wyceń stronę</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(11, 11, 12, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .site-header__inner {
    min-height: var(--header-h);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem 0.75rem;
    padding-block: 0.6rem;
  }
  .site-nav { grid-column: 1 / -1; }
  .site-header__brand { text-decoration: none; display: inline-flex; padding-block: 0.25rem; }
  .site-header__actions { display: flex; align-items: center; gap: 0.5rem; }

  /* Przycisk „Aplikacje” — widoczny obok menu na telefonie */
  .apps-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-btn);
    background: var(--accent-tint);
    border: 1px solid var(--accent-line);
    color: var(--text);
    font-size: var(--step--1);
    font-weight: 800;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .apps-link:hover, .apps-link[aria-current='page'] { border-color: var(--accent); }
  .apps-link__icon { display: grid; grid-template-columns: 5px 5px; gap: 2px; }
  .apps-link__icon i { width: 5px; height: 5px; border-radius: 1.5px; background: var(--accent); }
  /* Na wąskich ekranach: hamburger bez napisu, mniejsze odstępy */
  @media (max-width: 30rem) {
    .menu-toggle__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .menu-toggle { padding: 0.4rem 0.7rem; }
    .apps-link { padding: 0.4rem 0.7rem; }
  }
  @media (max-width: 22.5rem) {
    .site-header__brand :global(.lockup) { --lk: 1rem; }
    .apps-link__icon { display: none; }
  }

  .site-nav { display: flex; flex-direction: column; gap: 1rem; width: 100%; padding-block: 0.5rem 1rem; }
  .site-nav__list { list-style: none; padding: 0; display: flex; flex-direction: column; }
  .site-nav__list a {
    display: block;
    padding: 0.7rem 0;
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }
  .site-nav__list a { transition: color 0.15s; }
  .site-nav__list a:hover { color: var(--accent); }
  .site-nav__list a[aria-current='page'] { color: var(--accent); }

  /* Z JS: menu chowane za przyciskiem na mobile */
  .menu-toggle { display: none; }
  :global(.js) .menu-toggle { display: inline-flex; }
  :global(.js) .site-nav { display: none; }
  :global(.js) .site-nav.is-open { display: flex; }

  .menu-toggle {
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.8rem;
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .menu-toggle:hover { border-color: var(--accent); }
  .menu-toggle__icon, .menu-toggle__icon span,
  .menu-toggle__icon::before, .menu-toggle__icon::after { display: block; width: 18px; height: 2px; background: var(--accent); }
  .menu-toggle__icon { background: none; position: relative; height: 14px; display: flex; align-items: center; }
  .menu-toggle__icon::before, .menu-toggle__icon::after { content: ''; position: absolute; left: 0; transition: transform 0.2s; }
  .menu-toggle__icon::before { top: 0; }
  .menu-toggle__icon::after { bottom: 0; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon span { opacity: 0; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon::before { transform: translateY(6px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon::after { transform: translateY(-6px) rotate(-45deg); }

  @media (min-width: 60rem) {
    .site-header__inner { display: flex; justify-content: space-between; gap: 1.5rem; }
    .menu-toggle, :global(.js) .menu-toggle { display: none; }
    .site-header__actions { display: none; }
    .site-nav, :global(.js) .site-nav {
      display: flex;
      flex-direction: row;
      align-items: center;
      width: auto;
      padding: 0;
      gap: 1.75rem;
    }
    .site-nav__list { flex-direction: row; gap: 1.5rem; }
    .site-nav__list a { border: 0; padding: 0.5rem 0; font-size: var(--step--1); }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const navEl = document.getElementById('site-nav');
  if (toggle && navEl) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      navEl.classList.toggle('is-open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    navEl.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 60rem)').addEventListener('change', () => setOpen(false));
  }
</script>
