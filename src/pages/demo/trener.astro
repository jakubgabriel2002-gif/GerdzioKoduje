---
import '@fontsource/anton/latin-400.css';
import '@fontsource/anton/latin-ext-400.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-ext-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-ext-600.css';
import DemoLayout from '../../layouts/DemoLayout.astro';
import DemoForm from '../../components/demo/DemoForm.astro';
import DemoMap from '../../components/demo/DemoMap.astro';
import DemoHours from '../../components/demo/DemoHours.astro';

const offers = [
  { name: 'Trening próbny', price: '0 zł', unit: 'pierwsze spotkanie', points: ['rozmowa o celu', 'test sprawności', 'plan na start'] },
  { name: 'Pakiet 8 treningów', price: '760 zł', unit: '95 zł / trening', points: ['trening 1:1 (60 min)', 'plan ćwiczeń w aplikacji', 'pomiary co 4 tygodnie'], featured: true },
  { name: 'Prowadzenie online', price: '249 zł', unit: 'miesięcznie', points: ['plan treningowy', 'wskazówki żywieniowe', 'cotygodniowy kontakt'] },
];
const steps = [
  { title: 'Diagnoza', text: 'Sprawdzamy, jak się ruszasz, co boli i na czym Ci zależy.' },
  { title: 'Plan', text: 'Dostajesz plan dopasowany do grafiku, a nie odwrotnie.' },
  { title: 'Trening', text: 'Ćwiczymy razem, technika jest ważniejsza niż ciężar.' },
  { title: 'Efekt', text: 'Pomiary co 4 tygodnie pokazują postęp czarno na białym.' },
];
const results = [
  { label: 'Siła', value: 86 },
  { label: 'Kondycja', value: 72 },
  { label: 'Mobilność', value: 64 },
];
const reviews = [
  { text: 'Pierwszy raz od lat ćwiczę regularnie. Treningi są ciężkie, ale nigdy nie przesadzone.', who: 'Michał, 34 lata' },
  { text: 'Kręgosłup przestał boleć po dwóch miesiącach. Najlepsza decyzja tego roku.', who: 'Ania, 41 lat' },
  { text: 'Plan online idealnie wpasował się w moją pracę zmianową.', who: 'Kamil, 29 lat' },
];
const hours: [string, string][] = [
  ['Poniedziałek – piątek', '6:00 – 21:00'],
  ['Sobota', '8:00 – 14:00'],
  ['Niedziela', 'po umówieniu'],
];
const marquee = ['siła', 'kondycja', 'redukcja', 'mobilność', 'zdrowy kręgosłup', 'trening 1:1'];
---
<DemoLayout
  title="Forma Od Podstaw — trener personalny (demo) | Gerdzio Koduje"
  description="Strona pokazowa fikcyjnego trenera personalnego Forma Od Podstaw. Projekt: Gerdzio Koduje."
  themeColor="#0f1012"
  theme="trener"
>
  <header class="t-header">
    <div class="d-container t-header__in">
      <a href="#tresc" class="t-logo"><span class="t-logo__mark" aria-hidden="true"></span>Forma Od Podstaw</a>
      <nav aria-label="Menu trenera">
        <ul>
          <li><a href="#oferta">Oferta</a></li>
          <li><a href="#metoda">Metoda</a></li>
          <li><a href="#opinie">Opinie</a></li>
        </ul>
      </nav>
      <a class="t-btn t-btn--sm" href="#zapisy">Trening próbny</a>
    </div>
  </header>

  <main id="tresc">
    <section class="t-hero">
      <div class="d-container t-hero__in">
        <div class="t-hero__copy">
          <p class="t-kicker">Trener personalny · Przykładowo</p>
          <h1><span>Silniejszy</span> <span>każdego</span> <span class="t-hl">tygodnia.</span></h1>
          <p class="t-lead">Treningi 1:1 i prowadzenie online. Bez cudownych diet i bez krzyku — za to z planem, który da się utrzymać.</p>
          <div class="t-cta">
            <a class="t-btn" href="#zapisy">Umów trening próbny</a>
            <a class="t-link" href="#oferta">Zobacz cennik →</a>
          </div>
        </div>
        <div class="t-hero__art" aria-hidden="true">
          <span class="t-ring t-ring--1"></span>
          <span class="t-ring t-ring--2"></span>
          <span class="t-bar"><i></i></span>
          <div class="t-card">
            <p>Postęp klienta</p>
            <b><span data-count="12">12</span> tyg.</b>
            <span class="t-card__chart"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
          </div>
        </div>
      </div>
      <div class="d-marquee t-marquee" aria-hidden="true">
        <div class="d-marquee__track">
          {[...marquee, ...marquee].map((m) => <span>{m} <i>/</i></span>)}
        </div>
      </div>
    </section>

    <section class="t-stats">
      <div class="d-container t-stats__in">
        <div data-anim><b><span data-count="350" data-suffix="+">350+</span></b><span>przeprowadzonych treningów</span></div>
        <div data-anim><b><span data-count="48">48</span></b><span>podopiecznych</span></div>
        <div data-anim><b><span data-count="8">8</span> lat</b><span>doświadczenia</span></div>
      </div>
    </section>

    <section id="oferta" class="d-section">
      <div class="d-container">
        <div class="t-head" data-anim>
          <p class="t-kicker">Cennik</p>
          <h2>Wybierz swój start</h2>
        </div>
        <ul class="t-offers">
          {offers.map((o) => (
            <li class:list={['t-offer', { 't-offer--featured': o.featured }]} data-anim>
              {o.featured && <p class="t-offer__badge">Najpopularniejszy</p>}
              <h3>{o.name}</h3>
              <p class="t-offer__price">{o.price}</p>
              <p class="t-offer__unit">{o.unit}</p>
              <ul>{o.points.map((p) => <li>{p}</li>)}</ul>
              <a href="#zapisy" class="t-btn t-btn--block">Wybieram</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="metoda" class="d-section t-method">
      <div class="d-container t-method__in">
        <div>
          <div class="t-head" data-anim>
            <p class="t-kicker">Metoda</p>
            <h2>Cztery kroki do formy</h2>
          </div>
          <ol class="t-steps">
            {steps.map((s, i) => (
              <li data-anim="left">
                <span class="t-steps__no">{String(i + 1).padStart(2, '0')}</span>
                <div><h3>{s.title}</h3><p>{s.text}</p></div>
              </li>
            ))}
          </ol>
        </div>
        <div class="t-progress" data-anim="right">
          <p class="t-progress__title">Przykładowy postęp po 12 tygodniach</p>
          {results.map((r) => (
            <div class="t-progress__row">
              <span>{r.label}</span><b>+{r.value}%</b>
              <span class="t-progress__track"><i style={`--w:${r.value}%`}></i></span>
            </div>
          ))}
          <p class="t-progress__note">Dane przykładowe.</p>
        </div>
      </div>
    </section>

    <section id="opinie" class="d-section">
      <div class="d-container">
        <div class="t-head" data-anim>
          <p class="t-kicker">Opinie <span class="t-tag">przykładowe</span></p>
          <h2>Podopieczni mówią</h2>
        </div>
        <ul class="t-reviews">
          {reviews.map((r) => (
            <li data-anim>
              <blockquote><p>„{r.text}”</p></blockquote>
              <p class="t-reviews__who">{r.who}</p>
            </li>
          ))}
        </ul>
        <p class="t-note">Opinie przykładowe — trener jest fikcyjny.</p>
      </div>
    </section>

    <section id="zapisy" class="d-section t-contact">
      <div class="d-container t-contact__in">
        <div class="t-contact__info" data-anim>
          <p class="t-kicker">Zapisy</p>
          <h2>Pierwszy trening jest za darmo</h2>
          <p>Siłownia przy ul. Przykładowej 1, 00-000 Przykładowo<br />tel. <a href="tel:000000000">000 000 000</a> · kontakt@example.com</p>
          <h3>Dostępność</h3>
          <DemoHours hours={hours} caption="Dostępność trenera" />
          <DemoMap address="ul. Przykładowa 1, 00-000 Przykładowo" />
        </div>
        <div class="t-formcard" data-anim>
          <h3>Zapisz się na trening próbny</h3>
          <DemoForm id="t" services={offers.map((o) => o.name)} submitLabel="Zapisuję się" />
        </div>
      </div>
    </section>
  </main>

  <footer class="t-footer">
    <div class="d-container">
      <p class="t-logo"><span class="t-logo__mark" aria-hidden="true"></span>Forma Od Podstaw</p>
      <p>Trener fikcyjny · dane przykładowe · ul. Przykładowa 1, 00-000 Przykładowo</p>
    </div>
  </footer>
</DemoLayout>

<style is:global>
  .demo--trener {
    --d-bg: #0f1012;
    --d-text: #f2f2ee;
    --d-muted: #a9aaa4;
    --d-accent: #ffd23f;
    --d-surface: #17181b;
    --d-line: #2a2b30;
    --d-radius: 10px;
    --d-font-head: 'Anton', Impact, 'Arial Narrow', sans-serif;
    --d-font-body: 'Inter', system-ui, sans-serif;
    --d-input-bg: #0b0c0d;
    --d-input-text: #f2f2ee;
    --d-input-border: #45464d;
    --d-status-bg: #2b2610;
    --d-status-text: #ffe27a;
    --d-map-bg: #1b1c20;
    --d-map-road: #2c2d33;
    --d-map-block: #25262b;
    --d-map-green: #1f2a22;
  }
  .demo--trener h1, .demo--trener h2 { font-weight: 400; text-transform: uppercase; letter-spacing: 0.01em; }
  .demo--trener h2 { font-size: clamp(2.4rem, 1.8rem + 2.8vw, 4rem); line-height: 1; }
  .demo.demo--trener h3 { font-family: 'Inter', sans-serif; font-weight: 600; font-size: 1.1rem; text-transform: none; }
  .t-kicker { color: var(--d-accent); text-transform: uppercase; letter-spacing: 0.2em; font-size: 0.76rem; font-weight: 600; margin-bottom: 1rem; }
  .t-tag { color: var(--d-text); letter-spacing: 0.05em; text-transform: none; border: 1px solid var(--d-line); padding: 0.1rem 0.5rem; border-radius: 4px; margin-left: 0.4rem; }
  .t-head { margin-bottom: 2.5rem; }
  .t-note { color: var(--d-muted); font-size: 0.88rem; margin-top: 1.5rem; }

  .t-btn, .demo--trener .d-btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 3.1rem; padding: 0.8rem 1.6rem;
    background: var(--d-accent); color: #0f1012 !important; border: 0; border-radius: 6px;
    font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.88rem; text-decoration: none; cursor: pointer; justify-self: start;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .t-btn:hover, .demo--trener .d-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 30px -10px rgba(255, 210, 63, 0.6); }
  .t-btn--sm { min-height: 2.5rem; padding: 0.45rem 1rem; font-size: 0.75rem; }
  .t-btn--block { width: 100%; }
  .t-link { color: var(--d-text) !important; font-weight: 600; text-decoration: none; padding-block: 0.6rem; }
  .t-link:hover { color: var(--d-accent) !important; }

  .t-header { border-bottom: 1px solid var(--d-line); }
  .t-header__in { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 4.25rem; }
  .t-logo { display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--d-font-head); text-transform: uppercase; font-size: 1.25rem; letter-spacing: 0.03em; color: var(--d-text) !important; text-decoration: none; }
  .t-logo__mark { width: 1.1rem; height: 1.1rem; background: var(--d-accent); clip-path: polygon(0 100%, 50% 0, 100% 100%, 70% 100%, 50% 55%, 30% 100%); }
  .t-header nav { display: none; }
  .t-header nav ul { list-style: none; display: flex; gap: 2rem; padding: 0; }
  .t-header nav a { color: var(--d-text); text-decoration: none; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .t-header nav a:hover { color: var(--d-accent); }
  @media (min-width: 52rem) { .t-header nav { display: block; } }

  .t-hero { position: relative; padding-top: clamp(2.5rem, 1.5rem + 5vw, 6rem); overflow: hidden; }
  .t-hero__in { display: grid; gap: 3rem; align-items: center; }
  .t-hero h1 { font-size: clamp(3.2rem, 2rem + 6vw, 7rem); line-height: 0.92; }
  .t-hero h1 span { display: block; }
  .t-hl { color: var(--d-accent); }
  .t-lead { margin-top: 1.5rem; font-size: 1.1rem; color: var(--d-muted); max-width: 30rem; line-height: 1.65; }
  .t-cta { display: flex; flex-wrap: wrap; gap: 1.25rem; align-items: center; margin-top: 2rem; }
  .t-hero__art { position: relative; height: clamp(18rem, 14rem + 12vw, 28rem); }
  .t-ring { position: absolute; border-radius: 50%; border: 2px solid var(--d-line); }
  .t-ring--1 { inset: 4% 12% 4% 12%; border-color: #3a3b41; }
  .t-ring--2 { inset: 18% 26%; border: 14px solid var(--d-accent); border-right-color: transparent; border-bottom-color: transparent; }
  .t-bar { position: absolute; left: 8%; right: 8%; top: 50%; height: 14px; margin-top: -7px; border-radius: 7px; background: #2a2b30; }
  .t-bar::before, .t-bar::after { content: ''; position: absolute; top: 50%; width: 22px; height: 70px; margin-top: -35px; border-radius: 6px; background: #f2f2ee; }
  .t-bar::before { left: 12%; box-shadow: 30px 0 0 #f2f2ee; }
  .t-bar::after { right: 12%; box-shadow: -30px 0 0 #f2f2ee; }
  .t-card { position: absolute; right: 0; bottom: 4%; padding: 1rem 1.2rem; border-radius: 12px; background: var(--d-surface); border: 1px solid var(--d-line); box-shadow: 0 20px 50px -20px #000; }
  .t-card p { font-size: 0.78rem; color: var(--d-muted); text-transform: uppercase; letter-spacing: 0.1em; }
  .t-card b { display: block; font-family: var(--d-font-head); font-weight: 400; font-size: 2rem; color: var(--d-accent); }
  .t-card__chart { display: flex; align-items: flex-end; gap: 5px; height: 40px; margin-top: 0.4rem; }
  .t-card__chart i { width: 10px; border-radius: 3px; background: var(--d-accent); }
  .t-card__chart i:nth-child(1) { height: 20%; opacity: 0.4; } .t-card__chart i:nth-child(2) { height: 30%; opacity: 0.5; }
  .t-card__chart i:nth-child(3) { height: 38%; opacity: 0.6; } .t-card__chart i:nth-child(4) { height: 52%; opacity: 0.7; }
  .t-card__chart i:nth-child(5) { height: 66%; opacity: 0.8; } .t-card__chart i:nth-child(6) { height: 80%; opacity: 0.9; }
  .t-card__chart i:nth-child(7) { height: 100%; }
  .t-marquee { margin-top: clamp(3rem, 2rem + 3vw, 5rem); padding-block: 1rem; background: var(--d-accent); color: #0f1012; font-family: var(--d-font-head); text-transform: uppercase; font-size: 1.6rem; transform: rotate(-1.5deg); width: 104%; margin-left: -2%; }
  .t-marquee i { font-style: normal; margin-left: 2.5rem; opacity: 0.5; }
  @media (min-width: 56rem) { .t-hero__in { grid-template-columns: 1.15fr 1fr; } }
  @media (prefers-reduced-motion: no-preference) {
    .t-hero h1 span { animation: t-in 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) backwards; }
    .t-hero h1 span:nth-child(2) { animation-delay: 0.1s; }
    .t-hero h1 span:nth-child(3) { animation-delay: 0.2s; }
    .t-lead, .t-cta { animation: t-fade 0.8s 0.35s ease backwards; }
    .t-ring--2 { animation: t-spin 9s linear infinite; }
    .t-bar { animation: t-lift 2.4s ease-in-out infinite; }
    .t-card { animation: t-pop 0.7s 0.6s cubic-bezier(0.2, 0.9, 0.3, 1.3) backwards; }
    .t-card__chart i { animation: t-grow 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) backwards; }
    .t-card__chart i:nth-child(2) { animation-delay: 0.85s; } .t-card__chart i:nth-child(3) { animation-delay: 0.9s; }
    .t-card__chart i:nth-child(4) { animation-delay: 0.95s; } .t-card__chart i:nth-child(5) { animation-delay: 1s; }
    .t-card__chart i:nth-child(6) { animation-delay: 1.05s; } .t-card__chart i:nth-child(7) { animation-delay: 1.1s; }
    .t-card__chart i:nth-child(1) { animation-delay: 0.8s; }
  }
  @keyframes t-in { from { opacity: 0; transform: translateX(-40px); } }
  @keyframes t-fade { from { opacity: 0; transform: translateY(16px); } }
  @keyframes t-spin { to { transform: rotate(360deg); } }
  @keyframes t-lift { 50% { transform: translateY(-16px); } }
  @keyframes t-pop { from { opacity: 0; transform: scale(0.85) translateY(20px); } }
  @keyframes t-grow { from { transform: scaleY(0); transform-origin: bottom; } }

  .t-stats { border-block: 1px solid var(--d-line); margin-top: clamp(2rem, 1rem + 3vw, 3rem); }
  .t-stats__in { display: grid; grid-template-columns: repeat(3, 1fr); }
  .t-stats__in > div { padding: 2rem 0.5rem; text-align: center; display: grid; gap: 0.3rem; }
  .t-stats__in > div + div { border-left: 1px solid var(--d-line); }
  .t-stats b { font-family: var(--d-font-head); font-weight: 400; font-size: clamp(2rem, 1.4rem + 2.6vw, 3.4rem); color: var(--d-accent); }
  .t-stats span:not([data-count]) { color: var(--d-muted); font-size: 0.82rem; }

  .t-offers { list-style: none; padding: 0; display: grid; gap: 1.25rem; }
  .t-offer { position: relative; display: flex; flex-direction: column; gap: 0.6rem; padding: 2rem; background: var(--d-surface); border: 1px solid var(--d-line); border-radius: 14px; transition: transform 0.3s, border-color 0.3s; }
  .t-offer:hover { transform: translateY(-6px); border-color: #4a4b52; }
  .t-offer--featured { border-color: var(--d-accent); }
  .t-offer--featured:hover { border-color: var(--d-accent); }
  .t-offer__badge { position: absolute; top: -0.8rem; left: 2rem; padding: 0.25rem 0.7rem; border-radius: 4px; background: var(--d-accent); color: #0f1012; font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; }
  .t-offer__price { font-family: var(--d-font-head); font-size: 3.2rem; line-height: 1; margin-top: 0.4rem; }
  .t-offer__unit { color: var(--d-muted); font-size: 0.9rem; }
  .t-offer ul { list-style: none; padding: 0; display: grid; gap: 0.55rem; margin: 1rem 0 1.5rem; }
  .t-offer ul li { padding-left: 1.5rem; position: relative; }
  .t-offer ul li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 0.75rem; height: 3px; background: var(--d-accent); }
  .t-offer .t-btn { margin-top: auto; }
  .t-offer:not(.t-offer--featured) .t-btn { background: transparent; color: var(--d-text) !important; box-shadow: inset 0 0 0 1px #4a4b52; }
  .t-offer:not(.t-offer--featured) .t-btn:hover { box-shadow: inset 0 0 0 1px var(--d-accent); }
  @media (min-width: 60rem) { .t-offers { grid-template-columns: repeat(3, 1fr); } }

  .t-method { background: #141518; }
  .t-method__in { display: grid; gap: 3rem; align-items: center; }
  .t-steps { list-style: none; padding: 0; display: grid; gap: 1.5rem; }
  .t-steps li { display: flex; gap: 1.25rem; align-items: flex-start; }
  .t-steps__no { font-family: var(--d-font-head); font-size: 2.2rem; line-height: 1; color: var(--d-accent); min-width: 3rem; }
  .t-steps p { color: var(--d-muted); margin-top: 0.25rem; }
  .t-progress { padding: 2rem; border-radius: 16px; background: var(--d-surface); border: 1px solid var(--d-line); display: grid; gap: 1.4rem; }
  .t-progress__title { text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.78rem; color: var(--d-muted); }
  .t-progress__row { display: grid; grid-template-columns: 1fr auto; gap: 0.5rem; }
  .t-progress__row b { color: var(--d-accent); font-family: var(--d-font-head); font-weight: 400; font-size: 1.4rem; }
  .t-progress__track { grid-column: 1 / -1; height: 10px; border-radius: 5px; background: #2a2b30; overflow: hidden; }
  .t-progress__track i { display: block; height: 100%; width: var(--w); border-radius: 5px; background: var(--d-accent); }
  .anim-ready .t-progress .t-progress__track i { width: 0; transition: width 1.4s 0.3s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .anim-ready .t-progress.is-in .t-progress__track i { width: var(--w); }
  .t-progress__note { font-size: 0.8rem; color: var(--d-muted); }
  @media (min-width: 56rem) { .t-method__in { grid-template-columns: 1.1fr 1fr; } }

  .t-reviews { list-style: none; padding: 0; display: grid; gap: 1.25rem; }
  .t-reviews li { padding: 1.75rem; border-radius: 14px; background: var(--d-surface); border-left: 4px solid var(--d-accent); display: grid; gap: 1rem; }
  .t-reviews blockquote p { font-size: 1.08rem; line-height: 1.6; }
  .t-reviews__who { color: var(--d-accent); font-weight: 600; font-size: 0.9rem; }
  @media (min-width: 52rem) { .t-reviews { grid-template-columns: repeat(3, 1fr); } }

  .t-contact { background: #141518; }
  .t-contact__in { display: grid; gap: 2.5rem; }
  .t-contact__info { display: grid; gap: 1.2rem; align-content: start; }
  .t-contact__info p { color: var(--d-muted); }
