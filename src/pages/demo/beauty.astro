---
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-ext-500.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource/cormorant-garamond/latin-ext-500-italic.css';
import '@fontsource/jost/latin-400.css';
import '@fontsource/jost/latin-ext-400.css';
import '@fontsource/jost/latin-500.css';
import '@fontsource/jost/latin-ext-500.css';
import DemoLayout from '../../layouts/DemoLayout.astro';
import DemoForm from '../../components/demo/DemoForm.astro';
import DemoMap from '../../components/demo/DemoMap.astro';
import DemoHours from '../../components/demo/DemoHours.astro';

const categories = [
  {
    name: 'Twarz',
    items: [
      { name: 'Oczyszczanie wodorowe', time: '60 min', price: '180 zł' },
      { name: 'Peeling kawitacyjny + maska', time: '45 min', price: '140 zł' },
      { name: 'Zabieg nawilżający z kwasem hialuronowym', time: '60 min', price: '220 zł' },
    ],
  },
  {
    name: 'Dłonie',
    items: [
      { name: 'Manicure hybrydowy', time: '75 min', price: '120 zł' },
      { name: 'Manicure japoński', time: '45 min', price: '90 zł' },
      { name: 'Przedłużanie żelem', time: '120 min', price: '200 zł' },
    ],
  },
  {
    name: 'Brwi i rzęsy',
    items: [
      { name: 'Laminacja brwi z henną', time: '50 min', price: '130 zł' },
      { name: 'Lifting rzęs', time: '60 min', price: '150 zł' },
      { name: 'Regulacja brwi', time: '20 min', price: '40 zł' },
    ],
  },
];
const hours: [string, string][] = [
  ['Poniedziałek – piątek', '9:00 – 19:00'],
  ['Sobota', '9:00 – 14:00'],
  ['Niedziela', 'zamknięte'],
];
const reviews = [
  { text: 'Atmosfera jak w małym spa. Pani Ola wszystko wytłumaczyła i dobrała zabieg do mojej skóry.', who: 'Karolina' },
  { text: 'Hybryda trzyma się trzy tygodnie bez odprysków. Wracam co miesiąc.', who: 'Natalia' },
  { text: 'Laminacja brwi zmieniła moje poranki. Polecam z całego serca.', who: 'Agnieszka' },
];
const marquee = ['oczyszczanie wodorowe', 'manicure japoński', 'lifting rzęs', 'laminacja brwi', 'zabiegi nawilżające', 'przedłużanie żelem'];
const services = categories.flatMap((c) => c.items.map((i) => i.name));
---
<DemoLayout
  title="Atelier Malwa — salon kosmetyczny (demo) | Gerdzio Koduje"
  description="Strona pokazowa fikcyjnego salonu kosmetycznego Atelier Malwa. Projekt: Gerdzio Koduje."
  themeColor="#fbf6f2"
  theme="beauty"
>
  <header class="m-header">
    <div class="d-container m-header__in">
      <a href="#tresc" class="m-logo">Atelier <em>Malwa</em></a>
      <nav aria-label="Menu salonu">
        <ul>
          <li><a href="#zabiegi">Zabiegi</a></li>
          <li><a href="#o-nas">O nas</a></li>
          <li><a href="#opinie">Opinie</a></li>
        </ul>
      </nav>
      <a class="m-btn m-btn--sm" href="#rezerwacja">Rezerwuj</a>
    </div>
  </header>

  <main id="tresc">
    <section class="m-hero">
      <div class="d-container m-hero__in">
        <div class="m-hero__copy">
          <p class="m-eyebrow">Kosmetyka · Paznokcie · Brwi i rzęsy</p>
          <h1>Piękno, które <em>nie musi</em> się spieszyć.</h1>
          <p class="m-lead">Kameralny salon w Przykładowie. Zabiegi dobrane do Twojej skóry, spokojna atmosfera i czas tylko dla Ciebie.</p>
          <div class="m-cta">
            <a class="m-btn" href="#rezerwacja">Zarezerwuj wizytę</a>
            <a class="m-link" href="#zabiegi">Zobacz zabiegi</a>
          </div>
        </div>
        <div class="m-hero__art" aria-hidden="true">
          <span class="m-arch m-arch--big"><span class="m-arch__shine"></span></span>
          <span class="m-arch m-arch--small"></span>
          <span class="m-petal m-petal--1"></span>
          <span class="m-petal m-petal--2"></span>
          <span class="m-badge"><b>4.9</b> średnia ocen<br />klientek</span>
        </div>
      </div>
      <div class="d-marquee m-marquee" aria-hidden="true">
        <div class="d-marquee__track">
          {[...marquee, ...marquee].map((m) => <span>{m} <i>✦</i></span>)}
        </div>
      </div>
    </section>

    <section id="zabiegi" class="d-section">
      <div class="d-container">
        <div class="m-head" data-anim>
          <p class="m-eyebrow">Cennik</p>
          <h2>Zabiegi i ceny</h2>
        </div>
        <div class="m-cats">
          {categories.map((c) => (
            <div class="m-cat" data-anim>
              <h3>{c.name}</h3>
              <ul>
                {c.items.map((i) => (
                  <li>
                    <span class="m-cat__name">{i.name}<small>{i.time}</small></span>
                    <span class="m-cat__price">{i.price}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="o-nas" class="d-section m-about">
      <div class="d-container m-about__in">
        <div class="m-about__art" data-anim="left" aria-hidden="true">
          <span class="m-arch m-arch--about"></span>
          <span class="m-stamp">od<br /><b>2018</b></span>
        </div>
        <div data-anim="right">
          <p class="m-eyebrow">O nas</p>
          <h2>Mały salon, <em>duża uważność</em></h2>
          <p>Atelier Malwa to dwie kosmetolożki i jeden cel: żebyś wychodziła lżejsza, niż przyszłaś. Pracujemy na sprawdzonych kosmetykach i zawsze zaczynamy od rozmowy o Twojej skórze.</p>
          <ul class="m-stats">
            <li><b data-count="2400" data-suffix="+">2400+</b><span>wykonanych zabiegów</span></li>
            <li><b data-count="2">2</b><span>kosmetolożki</span></li>
            <li><b data-count="100" data-suffix="%">100%</b><span>sterylne narzędzia</span></li>
          </ul>
        </div>
      </div>
    </section>

    <section id="opinie" class="d-section">
      <div class="d-container">
        <div class="m-head" data-anim>
          <p class="m-eyebrow">Opinie <span class="m-tag">przykładowe</span></p>
          <h2>Mówią o nas</h2>
        </div>
        <ul class="m-reviews">
          {reviews.map((r) => (
            <li data-anim>
              <p class="m-stars" aria-label="Ocena 5 na 5">★★★★★</p>
              <blockquote><p>„{r.text}”</p></blockquote>
              <p class="m-reviews__who">{r.who}</p>
            </li>
          ))}
        </ul>
        <p class="m-note">Opinie przykładowe — salon jest fikcyjny.</p>
      </div>
    </section>

    <section id="rezerwacja" class="d-section m-contact">
      <div class="d-container m-contact__in">
        <div class="m-contact__info" data-anim>
          <p class="m-eyebrow">Rezerwacja</p>
          <h2>Umów wizytę</h2>
          <p>ul. Przykładowa 1, 00-000 Przykładowo<br />tel. <a href="tel:000000000">000 000 000</a> · kontakt@example.com</p>
          <h3>Godziny otwarcia</h3>
          <DemoHours hours={hours} />
          <DemoMap address="ul. Przykładowa 1, 00-000 Przykładowo" />
        </div>
        <div class="m-card" data-anim>
          <h3>Zapytaj o termin</h3>
          <DemoForm id="m" services={services} submitLabel="Wyślij prośbę o termin" />
        </div>
      </div>
    </section>
  </main>

  <footer class="m-footer">
    <div class="d-container">
      <p class="m-logo">Atelier <em>Malwa</em></p>
      <p>Salon fikcyjny · dane przykładowe · ul. Przykładowa 1, 00-000 Przykładowo</p>
    </div>
  </footer>
</DemoLayout>

<style is:global>
  .demo--beauty {
    --d-bg: #fbf6f2;
    --d-text: #2b1f1d;
    --d-muted: #6b5753;
    --d-accent: #a8465e;
    --d-surface: #ffffff;
    --d-line: #ead9cf;
    --d-radius: 16px;
    --d-font-head: 'Cormorant Garamond', Georgia, serif;
    --d-font-body: 'Jost', system-ui, sans-serif;
    --d-input-border: #c9b3a8;
    --d-status-bg: #f6e3e6;
    --d-status-text: #6d2236;
    --d-map-bg: #f3e8e1;
    --d-map-block: #e8d8ce;
    --d-map-green: #dfe5d3;
  }
  .demo--beauty h1, .demo--beauty h2 { font-weight: 500; letter-spacing: -0.01em; }
  .demo--beauty h2 { font-size: clamp(2.3rem, 1.7rem + 2.4vw, 3.6rem); }
  .demo--beauty h3 { font-family: var(--d-font-head); font-weight: 500; font-size: 1.7rem; }
  .demo--beauty em { font-style: italic; color: var(--d-accent); }
  .m-eyebrow { text-transform: uppercase; letter-spacing: 0.28em; font-size: 0.74rem; font-weight: 500; color: var(--d-accent); margin-bottom: 1rem; }
  .m-tag { letter-spacing: 0.05em; text-transform: none; padding: 0.1rem 0.5rem; border: 1px solid var(--d-accent); border-radius: 999px; margin-left: 0.4rem; }
  .m-note { color: var(--d-muted); font-size: 0.9rem; margin-top: 1.5rem; }
  .m-head { margin-bottom: 2.5rem; }

  .m-btn, .demo--beauty .d-btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 3.1rem; padding: 0.8rem 1.8rem;
    background: var(--d-text); color: #fbf6f2 !important; border: 0; border-radius: 999px;
    font-weight: 500; letter-spacing: 0.06em; text-decoration: none; cursor: pointer; justify-self: start;
    transition: background-color 0.3s, transform 0.3s;
  }
  .m-btn:hover, .demo--beauty .d-btn:hover { background: var(--d-accent); transform: translateY(-2px); }
  .m-btn--sm { min-height: 2.6rem; padding: 0.5rem 1.2rem; font-size: 0.9rem; }
  .m-link { color: var(--d-text) !important; text-underline-offset: 0.35em; padding-block: 0.6rem; }

  .m-header { border-bottom: 1px solid var(--d-line); }
  .m-header__in { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4.25rem; }
  .m-logo { font-family: var(--d-font-head); font-size: 1.6rem; font-weight: 500; color: var(--d-text) !important; text-decoration: none; }
  .m-header nav { display: none; }
  .m-header nav ul { list-style: none; display: flex; gap: 2.2rem; padding: 0; }
  .m-header nav a { color: var(--d-text); text-decoration: none; font-size: 0.92rem; letter-spacing: 0.04em; }
  .m-header nav a:hover { color: var(--d-accent); }
  @media (min-width: 50rem) { .m-header nav { display: block; } }

  .m-hero { padding-top: clamp(2.5rem, 1.5rem + 5vw, 6rem); overflow: hidden; }
  .m-hero__in { display: grid; gap: 3rem; align-items: center; }
  .m-hero h1 { font-size: clamp(2.8rem, 1.8rem + 4.6vw, 5.6rem); line-height: 1; }
  .m-lead { margin-top: 1.5rem; font-size: 1.12rem; color: var(--d-muted); max-width: 32rem; line-height: 1.7; }
  .m-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; margin-top: 2.2rem; }
  .m-hero__art { position: relative; height: clamp(17rem, 13rem + 12vw, 32rem); }
  .m-arch { position: absolute; display: block; border-radius: 999px 999px 18px 18px; overflow: hidden; }
  .m-arch--big { right: 8%; top: 0; width: 62%; height: 92%; background: linear-gradient(165deg, #f3d6d3 0%, #e7b9b5 45%, #c98d8c 100%); }
  .m-arch--small { left: 4%; bottom: 0; width: 34%; height: 55%; background: linear-gradient(180deg, #efe2d4, #d9c3ae); border: 6px solid #fbf6f2; }
  .m-arch__shine { position: absolute; inset: -40% auto auto -60%; width: 60%; height: 180%; background: rgba(255, 255, 255, 0.35); transform: rotate(20deg); }
  .m-petal { position: absolute; width: 4.5rem; height: 4.5rem; border-radius: 70% 0 70% 0; background: #a8465e; opacity: 0.85; }
  .m-petal--1 { right: 2%; top: 12%; }
  .m-petal--2 { left: 30%; top: 8%; width: 2.6rem; height: 2.6rem; background: #d7a35f; opacity: 0.8; }
  .m-badge { position: absolute; left: 20%; top: 40%; padding: 0.9rem 1.2rem; background: #fff; border-radius: 16px; box-shadow: 0 20px 40px -18px rgba(43, 31, 29, 0.35); font-size: 0.85rem; color: var(--d-muted); line-height: 1.3; }
  .m-badge b { display: block; font-family: var(--d-font-head); font-size: 2rem; color: var(--d-text); font-weight: 500; }
  .m-marquee { margin-top: clamp(3rem, 2rem + 3vw, 5rem); padding-block: 1.2rem; border-block: 1px solid var(--d-line); font-family: var(--d-font-head); font-style: italic; font-size: 1.6rem; color: var(--d-text); }
  .m-marquee i { font-style: normal; color: var(--d-accent); font-size: 1rem; margin-left: 2.5rem; }
  @media (min-width: 56rem) { .m-hero__in { grid-template-columns: 1.1fr 1fr; } }
  @media (prefers-reduced-motion: no-preference) {
    .m-hero__copy > * { animation: m-up 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) backwards; }
    .m-hero__copy > *:nth-child(2) { animation-delay: 0.1s; }
    .m-hero__copy > *:nth-child(3) { animation-delay: 0.2s; }
    .m-hero__copy > *:nth-child(4) { animation-delay: 0.3s; }
    .m-arch--big { animation: m-rise 1.1s 0.15s cubic-bezier(0.2, 0.7, 0.2, 1) backwards; }
    .m-arch--small { animation: m-rise 1.1s 0.35s cubic-bezier(0.2, 0.7, 0.2, 1) backwards; }
    .m-arch__shine { animation: m-shine 5s 1.2s ease-in-out infinite; }
    .m-petal--1 { animation: m-float 6s ease-in-out infinite; }
    .m-petal--2 { animation: m-float 7s 1s ease-in-out infinite reverse; }
    .m-badge { animation: m-pop 0.7s 0.8s cubic-bezier(0.2, 0.9, 0.3, 1.3) backwards; }
  }
  @keyframes m-up { from { opacity: 0; transform: translateY(24px); } }
  @keyframes m-rise { from { opacity: 0; transform: translateY(60px) scale(0.96); } }
  @keyframes m-pop { from { opacity: 0; transform: scale(0.8); } }
  @keyframes m-float { 50% { transform: translateY(-14px) rotate(8deg); } }
  @keyframes m-shine { 0%, 60% { transform: translateX(0) rotate(20deg); } 100% { transform: translateX(380%) rotate(20deg); } }

  .m-cats { display: grid; gap: 1.25rem; }
  .m-cat { background: var(--d-surface); border-radius: 22px; padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem); border: 1px solid var(--d-line); transition: transform 0.35s, box-shadow 0.35s; }
  .m-cat:hover { transform: translateY(-4px); box-shadow: 0 24px 50px -30px rgba(43, 31, 29, 0.35); }
  .m-cat h3 { margin-bottom: 1rem; color: var(--d-accent); font-style: italic; }
  .m-cat ul { list-style: none; padding: 0; display: grid; gap: 1rem; }
  .m-cat li { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--d-line); }
  .m-cat li:last-child { border-bottom: 0; padding-bottom: 0; }
  .m-cat__name small { display: block; color: var(--d-muted); font-size: 0.85rem; }
  .m-cat__price { font-family: var(--d-font-head); font-size: 1.45rem; white-space: nowrap; }
  @media (min-width: 60rem) { .m-cats { grid-template-columns: repeat(3, 1fr); } }

  .m-about { background: #f4e9e2; }
  .m-about__in { display: grid; gap: 3rem; align-items: center; }
  .m-about__in p:not(.m-eyebrow) { color: var(--d-muted); margin-top: 1.1rem; max-width: 34rem; font-size: 1.05rem; line-height: 1.75; }
  .m-about__art { position: relative; height: 24rem; max-width: 24rem; width: 100%; justify-self: center; }
  .m-arch--about { inset: 0; background: linear-gradient(170deg, #e9c9c2, #b98581); }
  .m-stamp { position: absolute; right: -1rem; bottom: 2rem; width: 7rem; height: 7rem; border-radius: 50%; background: var(--d-text); color: #fbf6f2; display: grid; place-content: center; text-align: center; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .m-stamp b { font-family: var(--d-font-head); font-size: 1.9rem; letter-spacing: 0; font-weight: 500; }
  .m-stats { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2rem; }
  .m-stats b { display: block; font-family: var(--d-font-head); font-size: clamp(2rem, 1.6rem + 1.4vw, 2.8rem); font-weight: 500; color: var(--d-accent); }
  .m-stats span { font-size: 0.85rem; color: var(--d-muted); }
  @media (min-width: 56rem) { .m-about__in { grid-template-columns: 1fr 1.2fr; } }

  .m-reviews { list-style: none; padding: 0; display: grid; gap: 1.25rem; }
  .m-reviews li { background: var(--d-surface); border-radius: 22px; padding: 1.75rem; display: grid; gap: 0.9rem; border: 1px solid var(--d-line); }
  .m-stars { color: #b07a2f; letter-spacing: 0.15em; }
  .m-reviews blockquote p { font-family: var(--d-font-head); font-style: italic; font-size: 1.4rem; line-height: 1.35; }
  .m-reviews__who { color: var(--d-accent); letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.78rem; }
  @media (min-width: 52rem) { .m-reviews { grid-template-columns: repeat(3, 1fr); } }

  .m-contact { background: #f4e9e2; }
  .m-contact__in { display: grid; gap: 2.5rem; }
  .m-contact__info { display: grid; gap: 1.2rem; align-content: start; }
  .m-card { background: var(--d-surface); border-radius: 24px; padding: clamp(1.4rem, 1rem + 1.5vw, 2.4rem); display: grid; gap: 1rem; align-self: start; box-shadow: 0 30px 60px -40px rgba(43, 31, 29, 0.4); }
  @media (min-width: 60rem) { .m-contact__in { grid-template-columns: 1fr 1.2fr; } }

  .m-footer { padding-block: 2.5rem; text-align: center; color: var(--d-muted); font-size: 0.88rem; border-top: 1px solid var(--d-line); }
  .m-footer .d-container { display: grid; gap: 0.4rem; justify-items: center; }
</style>
