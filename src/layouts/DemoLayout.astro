---
/** Layout stron demo — bez stylu Gerdzio Koduje; każde demo ma własny motyw. */
import Head from './Head.astro';
import DemoBar from '../components/demo/DemoBar.astro';
import type { DemoVersion } from '../config';
interface Props { title: string; description: string; themeColor: string; theme: string; firm: string; version: DemoVersion }
const { title, description, themeColor, theme, firm, version } = Astro.props;
---
<!doctype html>
<html lang="pl">
  <head>
    <Head title={title} description={description} themeColor={themeColor} />
    <script is:inline>document.documentElement.classList.add('d-js');</script>
  </head>
  <body class:list={['demo', `demo--${theme}`]}>
    <a class="d-skip" href="#tresc">Przejdź do treści</a>
    <DemoBar firm={firm} version={version} />
    <slot />
    <script>
      import '../scripts/demo-anim';
    </script>
  </body>
</html>

<style is:global>
  :where(.demo *, .demo *::before, .demo *::after) { box-sizing: border-box; }
  :where(.demo, .demo *) { margin: 0; }
  .demo [hidden] { display: none !important; }
  .demo {
    background: var(--d-bg);
    color: var(--d-text);
    font-family: var(--d-font-body);
    font-size: 1rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  .demo img, .demo svg { display: block; max-width: 100%; height: auto; }
  .demo input, .demo button, .demo textarea, .demo select { font: inherit; color: inherit; }
  .demo h1, .demo h2, .demo h3 { font-family: var(--d-font-head); line-height: 1.12; text-wrap: balance; overflow-wrap: break-word; }
  .demo a { color: var(--d-link, var(--d-accent)); }
  .demo :focus-visible { outline: 3px solid var(--d-focus, var(--d-accent)); outline-offset: 3px; }
  .d-container { width: min(100% - 2rem, 70rem); margin-inline: auto; }
  .d-section { padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem); }
  .d-skip { position: absolute; left: 1rem; top: -100px; z-index: 200; background: #fff; color: #000; padding: 0.5rem 1rem; }
  .d-skip:focus { top: 3.5rem; }
  /* Przycisk drugorzędny (np. w kontakcie Wizytówki) */
  .demo .d-btn--ghost { background: transparent !important; color: var(--d-text) !important; box-shadow: inset 0 0 0 1.5px currentColor; }
  .demo .d-btn--ghost:hover { background: transparent !important; color: var(--d-accent) !important; }
  .demo a.d-btn { text-decoration: none; }
  .d-visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  html:has(.demo) { scroll-padding-top: 4.5rem; }

  /* Animacje przy przewijaniu (src/scripts/demo-anim.ts) — tylko gdy JS i ruch są dozwolone */
  .anim-ready [data-anim] {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: var(--anim-delay, 0s);
  }
  .anim-ready [data-anim='left'] { transform: translateX(-40px); }
  .anim-ready [data-anim='right'] { transform: translateX(40px); }
  .anim-ready [data-anim='zoom'] { transform: scale(0.94); }
  .anim-ready [data-anim].is-in { opacity: 1; transform: none; }

  /* Wspólne: przewijany pasek (marquee) */
  .d-marquee { overflow: hidden; white-space: nowrap; }
  .d-marquee__track { display: inline-flex; gap: 3rem; padding-right: 3rem; animation: d-marquee 28s linear infinite; }
  @keyframes d-marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .d-marquee__track { animation: none; }
    .demo *, .demo *::before, .demo *::after { animation-duration: 0.001s !important; animation-iteration-count: 1 !important; transition-duration: 0.001s !important; }
  }
  @media (prefers-reduced-motion: no-preference) { html:has(.demo) { scroll-behavior: smooth; } }
</style>
