---
import { demos } from '../../config';
---
<section id="portfolio" class="section" aria-labelledby="portfolio-title">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">portfolio</span>
      <h2 id="portfolio-title">Zobacz, jak to może wyglądać</h2>
      <p>Trzy kompletne strony pokazowe dla fikcyjnych lokalnych firm. Każda w innym stylu — bo strona ma pasować do Twojej branży, nie do mnie.</p>
    </div>
    <ul class="demos">
      {demos.map((d) => (
        <li class="demo-card">
          <a href={`/demo/${d.slug}`} class="demo-card__link">
            <img src={d.image} width="800" height="500" loading="lazy" decoding="async" alt={`Podgląd strony pokazowej: ${d.name}`} />
            <span class="demo-card__body">
              <span class="demo-card__label">DEMO · firma fikcyjna</span>
              <span class="demo-card__name">{d.name}</span>
              <span class="demo-card__industry">{d.industry}</span>
              <span class="demo-card__text">{d.text}</span>
              <span class="demo-card__cta">otwórz demo <span aria-hidden="true">→</span></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .demos { list-style: none; padding: 0; display: grid; gap: var(--space-m); }
  .demo-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .demo-card__link:hover { border-color: var(--accent); }
  .demo-card img { width: 100%; aspect-ratio: 8 / 5; object-fit: cover; border-bottom: 1px solid var(--border); background: var(--bg-raised-2); }
  .demo-card__body { display: grid; gap: 0.45rem; padding: var(--space-m); flex: 1; align-content: start; }
  .demo-card__label {
    justify-self: start;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: var(--step--1);
    border-radius: 3px;
  }
  .demo-card__name { font-weight: 800; font-size: var(--step-1); }
  .demo-card__industry { color: var(--text-dim); font-size: var(--step--1); }
  .demo-card__text { color: var(--text-muted); }
  .demo-card__cta { color: var(--accent); font-weight: 800; padding-top: 0.5rem; }
  @media (min-width: 48rem) { .demos { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .demos { grid-template-columns: repeat(3, 1fr); } }
</style>
