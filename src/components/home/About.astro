---
import SocialLinks from '../SocialLinks.astro';
import Logo from '../Logo.astro';
---
<section id="o-mnie" class="section" aria-labelledby="o-mnie-title">
  <div class="container about">
    <div class="about__visual" aria-hidden="true">
      <Logo size="clamp(4rem, 3rem + 6vw, 7.5rem)" label={false} />
    </div>
    <div class="about__text">
      <h2 id="o-mnie-title">Cześć, jestem Jakub</h2>
      <p>Programuję od dzieciaka. Dziś buduję strony i aplikacje z pomocą AI.</p>
      <p>W sieci jako <strong>Gerdzio Koduje</strong> pokazuję cały proces bez ściemy: co działa, co nie, ile to trwa i ile kosztuje. Tak samo pracuję z klientami.</p>
      <SocialLinks class="about__social" />
    </div>
  </div>
</section>

<style>
  .about { display: grid; gap: clamp(2rem, 1.5rem + 3vw, 4rem); align-items: center; }
  .about__visual {
    display: grid;
    place-items: center;
    aspect-ratio: 5 / 4;
    width: 100%;
    max-width: 30rem;
    border-radius: var(--radius-lg);
    background-color: var(--bg-raised);
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 32px 32px;
    border: 1px solid var(--border);
  }
  .about__text { display: grid; gap: 1.1rem; max-width: 38rem; }
  .about__text h2 { margin-bottom: 0.25rem; }
  .about__text p { color: var(--text-muted); font-size: var(--step-1); line-height: 1.6; }
  .about__text strong { color: var(--text); }
  .about__text :global(.about__social) { margin-top: 0.75rem; }
  @media (min-width: 60rem) { .about { grid-template-columns: 1fr 1.15fr; } }
</style>
