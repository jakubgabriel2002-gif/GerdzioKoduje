---
import '@fontsource/playfair-display/latin-700.css';
import '@fontsource/playfair-display/latin-ext-700.css';
import '@fontsource/playfair-display/latin-600-italic.css';
import '@fontsource/playfair-display/latin-ext-600-italic.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-ext-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-ext-600.css';
import './theme.css';
import DemoLayout from '../../layouts/DemoLayout.astro';
import DemoHeader from '../../components/demo/DemoHeader.astro';
import { demos, demoUrl, demoPackage, type DemoVersion } from '../../config';

interface Props { version: DemoVersion; page?: string; title: string }
const { version, page = '', title } = Astro.props;
const firm = demos.find((d) => d.slug === 'barber')!;
const links =
  version === 'firmowa'
    ? firm.pages.map((p) => ({ label: p.label, href: demoUrl(firm.slug, 'firmowa', p.path), current: p.path === page }))
    : [{ label: 'O nas', href: '#o-nas' }, { label: 'Cennik', href: '#uslugi' }, { label: 'Kontakt', href: '#kontakt' }];
const cta = version === 'firmowa'
  ? { label: 'Rezerwacja', href: demoUrl(firm.slug, 'firmowa', 'rezerwacja') }
  : { label: 'Zadzwoń', href: 'tel:000000000' };
---
<DemoLayout
  title={`${title} — ${firm.name} (demo: ${demoPackage(version).name}) | Gerdzio Koduje`}
  description={`Strona pokazowa fikcyjnego barber shopu ${firm.name} w pakiecie ${demoPackage(version).name}. Projekt: Gerdzio Koduje.`}
  themeColor="#141210"
  theme="barber"
  firm={firm.slug}
  version={version}
>
  <DemoHeader links={links} cta={cta} brandHref={demoUrl(firm.slug, version)}>
    <span slot="brand" class="b-logo">Brzytwa <em>&amp;</em> Grzebień</span>
  </DemoHeader>
  <main id="tresc"><slot /></main>
  <footer class="b-footer">
    <div class="d-container">
      <p class="b-logo">Brzytwa <em>&amp;</em> Grzebień</p>
      {version === 'firmowa' && (
        <ul class="b-footer__links">
          {firm.pages.map((p) => <li><a href={demoUrl(firm.slug, 'firmowa', p.path)}>{p.label}</a></li>)}
        </ul>
      )}
      <p>Firma fikcyjna · dane przykładowe · ul. Przykładowa 1, 00-000 Przykładowo · tel. 000 000 000</p>
    </div>
  </footer>
</DemoLayout>
