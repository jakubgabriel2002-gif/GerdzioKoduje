---
import Turnstile from './Turnstile.astro';
import { packageOptions, quote } from '../../config';
---
<form class="form" action="/api/lead" method="post" data-quote-package={quote.package} data-enhance data-success="Dzięki! Zapytanie dotarło. Na maila przyszło potwierdzenie — odezwę się w ciągu 24 h.">
  <div class="form__row form__row--2">
    <div class="field">
      <label for="lead-name">Imię <span class="req" aria-hidden="true">*</span></label>
      <input id="lead-name" name="name" type="text" autocomplete="given-name" required maxlength="80" />
    </div>
    <div class="field">
      <label for="lead-company">Nazwa firmy <span class="req" aria-hidden="true">*</span></label>
      <input id="lead-company" name="company" type="text" autocomplete="organization" required maxlength="120" />
    </div>
  </div>
  <div class="form__row form__row--2">
    <div class="field">
      <label for="lead-email">E-mail <span class="req" aria-hidden="true">*</span></label>
      <input id="lead-email" name="email" type="email" autocomplete="email" required maxlength="254" />
    </div>
    <div class="field">
      <label for="lead-phone">Telefon <span class="dim">(opcjonalnie)</span></label>
      <input id="lead-phone" name="phone" type="tel" autocomplete="tel" maxlength="30" />
    </div>
  </div>
  <div class="form__row form__row--2">
    <div class="field">
      <label for="lead-industry">Branża <span class="req" aria-hidden="true">*</span></label>
      <input id="lead-industry" name="industry" type="text" required maxlength="80" placeholder="np. warsztat, gabinet" />
    </div>
    <div class="field">
      <label for="lead-package">Pakiet</label>
      <select id="lead-package" name="package">
        {packageOptions.map((o) => <option value={o.name} data-id={o.id} selected={o.id === 'nie-wiem'}>{o.name}</option>)}
      </select>
    </div>
  </div>

  <fieldset class="quote-box" data-quote-fields>
    <legend class="quote-box__legend">Szczegóły indywidualnej wyceny <span class="dim">(opcjonalnie)</span></legend>
    <div class="quote-box__inner">
    <div class="field">
      <span class="field__label" id="lead-types-label">Czego potrzebujesz?</span>
      <div class="choices choices--grid" role="group" aria-labelledby="lead-types-label">
        {quote.projectTypes.map((t) => (
          <label class="choice"><input type="checkbox" name="projectTypes" value={t} /> {t}</label>
        ))}
      </div>
    </div>
    <div class="form__row form__row--2">
      <div class="field">
        <label for="lead-budget">Orientacyjny budżet</label>
        <select id="lead-budget" name="budget">
          {quote.budgets.map((o) => <option value={o}>{o}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="lead-deadline">Kiedy chcesz zacząć?</label>
        <select id="lead-deadline" name="deadline">
          {quote.deadlines.map((o) => <option value={o}>{o}</option>)}
        </select>
      </div>
    </div>
    </div>
  </fieldset>

  <fieldset class="field">
    <legend class="field__label">Czy masz już stronę?</legend>
    <div class="choices">
      <label class="choice"><input type="radio" name="hasSite" value="nie" checked /> nie</label>
      <label class="choice"><input type="radio" name="hasSite" value="tak" /> tak</label>
    </div>
  </fieldset>
  <div class="field" data-site-url>
    <label for="lead-site">Link do obecnej strony <span class="dim">(jeśli masz)</span></label>
    <input id="lead-site" name="siteUrl" type="text" inputmode="url" autocomplete="url" maxlength="300" placeholder="https://" />
  </div>

  <div class="field">
    <label for="lead-message">Wiadomość <span class="req" aria-hidden="true">*</span></label>
    <textarea id="lead-message" name="message" required minlength="10" maxlength="3000" aria-describedby="lead-message-hint"></textarea>
    <p class="field__hint" id="lead-message-hint">Czym zajmuje się firma i czego oczekujesz od strony? Kilka zdań wystarczy.</p>
  </div>

  <div class="hp" aria-hidden="true">
    <label for="lead-website">Nie wypełniaj tego pola</label>
    <input id="lead-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <label class="consent">
    <input type="checkbox" name="consent" value="tak" required />
    <span>Zgadzam się na przetwarzanie moich danych w celu odpowiedzi na zapytanie, zgodnie z <a href="/polityka-prywatnosci">polityką prywatności</a>. <span class="req" aria-hidden="true">*</span></span>
  </label>

  <Turnstile />

  <div class="form__actions">
    <button class="btn" type="submit">Wyślij zapytanie</button>
    <span class="field__hint"><span class="req" aria-hidden="true">*</span> pole wymagane</span>
  </div>
  <div class="form__status" role="status" aria-live="polite"></div>
</form>

<script>
  import '../../scripts/form';
  // Pole na link pokazujemy tylko przy „tak” (bez JS widoczne zawsze).
  document.querySelectorAll<HTMLFormElement>('form[action="/api/lead"]').forEach((form) => {
    const box = form.querySelector<HTMLElement>('[data-site-url]');
    if (!box) return;
    const sync = () => {
      const yes = (form.querySelector<HTMLInputElement>('input[name="hasSite"]:checked')?.value ?? 'nie') === 'tak';
      box.hidden = !yes;
      if (!yes) box.querySelector('input')!.value = '';
    };
    form.addEventListener('change', (e) => {
      if ((e.target as HTMLInputElement).name === 'hasSite') sync();
    });
    form.addEventListener('reset', () => setTimeout(sync));
    sync();
  });
  // Wejście z adresem ?pakiet=<id> (np. „Chcę taką” w demach) od razu wybiera pakiet.
  const fromUrl = new URLSearchParams(location.search).get('pakiet');
  if (fromUrl) {
    const sel = document.querySelector<HTMLSelectElement>('#lead-package');
    const opt = sel?.querySelector<HTMLOptionElement>(`option[data-id="${CSS.escape(fromUrl)}"]`);
    if (sel && opt) {
      sel.value = opt.value;
      sel.dispatchEvent(new Event('change', { bubbles: true }));
    }
  }
  // Opieka dotyczy istniejącej strony — od razu zaznaczamy „mam stronę” i pokazujemy pole na link.
  document.querySelectorAll<HTMLSelectElement>('#lead-package').forEach((sel) =>
    sel.addEventListener('change', () => {
      if (sel.selectedOptions[0]?.dataset.id !== 'opieka') return;
      const yes = sel.form?.querySelector<HTMLInputElement>('input[name="hasSite"][value="tak"]');
      if (yes && !yes.checked) {
        yes.checked = true;
        yes.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }),
  );
  // Klik w „Zapytaj o …” przy pakiecie ustawia go w formularzu.
  document.querySelectorAll<HTMLAnchorElement>('a[data-package]').forEach((a) =>
    a.addEventListener('click', () => {
      const sel = document.querySelector<HTMLSelectElement>('#lead-package');
      if (!sel) return;
      sel.value = a.dataset.package!;
      sel.dispatchEvent(new Event('change', { bubbles: true }));
    }),
  );
  // Indywidualna wycena: dodatkowe pola tylko po wybraniu tego pakietu (bez JS widoczne zawsze).
  document.querySelectorAll<HTMLFormElement>('form[data-quote-package]').forEach((form) => {
    const box = form.querySelector<HTMLFieldSetElement>('[data-quote-fields]');
    const sel = form.querySelector<HTMLSelectElement>('#lead-package');
    const hint = form.querySelector<HTMLElement>('#lead-message-hint');
    const label = form.querySelector<HTMLElement>('label[for="lead-message"]');
    if (!box || !sel) return;
    const defaultHint = hint?.textContent ?? '';
    const sync = () => {
      const isQuote = sel.value === form.dataset.quotePackage;
      box.hidden = !isQuote;
      box.disabled = !isQuote;
      if (hint) hint.textContent = isQuote
        ? 'Opisz pomysł: co ma robić strona lub aplikacja, dla kogo jest i co Ci się podoba u innych.'
        : defaultHint;
      if (label?.firstChild) label.firstChild.textContent = isQuote ? 'Opis pomysłu ' : 'Wiadomość ';
    };
    sel.addEventListener('change', sync);
    form.addEventListener('reset', () => setTimeout(sync));
    sync();
  });
</script>
