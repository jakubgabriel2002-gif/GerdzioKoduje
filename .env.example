# Skopiuj ten plik:
#   - jako .env       → dla `npm run dev` / `npm run build` (klucz publiczny Turnstile),
#   - jako .dev.vars  → dla `npm run cf:dev` (funkcje /api/* lokalnie przez Wranglera).
# Na produkcji te same zmienne ustawiasz w Cloudflare Pages:
#   Settings → Variables and Secrets (Production). Nie commituj prawdziwych wartości!

# Główny adres strony (bez https://). Gdy ustawiony, www.gerdziokoduje.pl i gerdziokoduje.pages.dev
# przekierowują (301) na ten adres. Formularze (/api/*) i podglądy gałęzi nie są przekierowywane.
# Lokalnie zostaw puste.
CANONICAL_HOST=gerdziokoduje.pl

# URL wdrożonej aplikacji internetowej Google Apps Script (kończy się na /exec).
# Skąd go wziąć: automation/README.md, krok 4.
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# Wspólny sekret: długi losowy ciąg znaków. Ten sam wpisujesz we Właściwościach
# skryptu Apps Script (klucz SECRET). Dzięki temu nikt poza Twoją stroną nie dopisze nic do arkusza.
# Wygenerujesz go np. tak:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
APPS_SCRIPT_SECRET=zmien-mnie-na-dlugi-losowy-ciag

# Stripe — płatności zaliczek online (opcjonalne). Bez tych zmiennych płatności online są wyłączone.
# Klucz: dashboard.stripe.com → Programiści → Klucze API (najlepiej „klucz ograniczony” z uprawnieniem
# Checkout Sessions: Zapis) — klucz LIVE (rk_live_…). Konfiguracja: automation/README.md.
STRIPE_SECRET_KEY=
# Sekret webhooka (whsec_…): Programiści → Webhooki → endpoint https://TWOJA-STRONA/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# Cloudflare Turnstile (antyspam) — dash.cloudflare.com → Turnstile → Add widget.
# Site key jest publiczny (strona pobiera go z /api/turnstile-key). Pusty = widget się nie wyświetla.
TURNSTILE_SITE_KEY=

# Secret key — tylko po stronie serwera. Pusty = weryfikacja pomijana (tryb dev).
# Na produkcji ustaw jako „Secret” (zaszyfrowana zmienna).
TURNSTILE_SECRET=
