---
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <h1 id="hero-title">Strony dla firm, które same obsługują klientów.</h1>
      <p class="hero__lead">
        Robię strony dla lokalnych firm. Klient wypełnia formularz, od razu dostaje odpowiedź, a Ty masz zgłoszenie w arkuszu — bez odbierania telefonów w trakcie pracy.
      </p>
      <div class="hero__actions">
        <a class="btn" href="#kontakt">Wyceń stronę <span class="btn__arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--secondary" href="#portfolio">Zobacz przykłady</a>
      </div>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="logo3d" data-logo3d>
        <svg class="logo3d__fallback" viewBox="2 16 60 32" aria-hidden="true">
          <g fill="none" stroke-linecap="square" stroke-linejoin="miter">
            <path d="M13.5 22 L5.5 32 L13.5 42" stroke="#22E07A" stroke-width="4.2"/>
            <path d="M17.5 45 L24 19" stroke="#22E07A" stroke-width="4"/>
            <path d="M43.4 24.6 A 8 12 0 1 0 44.2 38.6 L 44.2 33.2 L 38.6 33.2" stroke="#F5F5F2" stroke-width="4.4"/>
            <path d="M50.5 22 L58.5 32 L50.5 42" stroke="#22E07A" stroke-width="4.2"/>
          </g>
        </svg>
      </div>
      <div class="notify">
        <span class="notify__dot"></span>
        <div>
          <p class="notify__title">Nowe zapytanie</p>
          <p class="notify__text">Manicure hybrydowy, sobota rano</p>
          <p class="notify__meta">zapisano w arkuszu · odpowiedź wysłana</p>
        </div>
      </div>
    </div>
  </div>

</section>

<script>
  // Logo 3D ładujemy dopiero, gdy strona jest gotowa (Three.js w osobnym pliku, tylko tutaj).
  const host = document.querySelector<HTMLElement>('[data-logo3d]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasGL = () => {
    try { return !!document.createElement('canvas').getContext('webgl2'); } catch { return false; }
  };
  if (host && !reduce && hasGL()) {
    // płaskie logo chowamy od razu, żeby kawałki 3D „wpadły” na puste miejsce (bez podmiany)
    host.classList.add('will-3d');
    // jeśli 3D długo się ładuje (słaby internet / telefon), na chwilę wraca płaskie logo
    const slow = setTimeout(() => host.classList.remove('will-3d'), 1800);
    new MutationObserver((_, mo) => {
      if (host.classList.contains('is-3d')) { clearTimeout(slow); mo.disconnect(); }
    }).observe(host, { attributes: true, attributeFilter: ['class'] });
    const go = () =>
      import('../../scripts/logo3d')
        .then((m) => m.mountLogo3D(host, { trigger: host.closest('section') ?? host }))
        .catch(() => host.classList.remove('will-3d')); // błąd = wraca płaskie logo
    if (document.readyState === 'complete') go();
    else window.addEventListener('load', go, { once: true });
  }
</script>

<style>
  .hero {
    position: relative;
    view-transition-name: vt-firm;
    padding-block: clamp(3rem, 2rem + 5vw, 6.5rem) clamp(3rem, 2rem + 4vw, 5rem);
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 56px 56px;
    background-position: center top;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 45%;
    background: var(--bg);
    mask-image: linear-gradient(to bottom, transparent, #000);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000);
    pointer-events: none;
  }
  .hero > .container { position: relative; z-index: 1; }

  .hero__grid { display: grid; gap: clamp(2.5rem, 2rem + 3vw, 4rem); align-items: center; }
  .hero h1 { font-size: clamp(2.1rem, 1.5rem + 2.6vw, 3.6rem); line-height: 1.07; letter-spacing: -0.035em; max-width: 17ch; }
  .hero__lead { margin-top: 1.5rem; max-width: 36rem; color: var(--text-muted); font-size: var(--step-1); line-height: 1.6; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.25rem; }
  .hero__actions .btn { flex: 1 1 12rem; }
  @media (min-width: 40rem) { .hero__actions .btn { flex: 0 0 auto; } }

  .hero__visual { position: relative; order: -1; margin-block: -1rem -1.5rem; }
  /* Logo 3D (src/scripts/logo3d.ts); bez WebGL / przy ograniczonym ruchu zostaje płaskie SVG */
  .logo3d { position: relative; height: clamp(11rem, 48vw, 15rem); }
  .logo3d::before {
    content: ''; position: absolute; inset: 10% 15%; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(34, 224, 122, 0.22), transparent);
    filter: blur(20px); pointer-events: none;
  }
  .logo3d__fallback { position: absolute; inset: 12% 8%; width: 84%; height: 76%; filter: drop-shadow(0 12px 30px rgba(34, 224, 122, 0.25)); transition: opacity 0.5s; }
  .logo3d :global(.logo3d__canvas) { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: pan-y; }
  .logo3d.will-3d .logo3d__fallback { opacity: 0; transition: none; }
  .logo3d.is-3d .logo3d__fallback { opacity: 0; transition: opacity 0.25s; }
    .notify {
    position: absolute;
    left: -3rem;
    bottom: -3.25rem;
    display: none;
    gap: 0.8rem;
    align-items: flex-start;
    padding: 1rem 1.2rem;
    background: #141416;
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    box-shadow: 0 20px 50px -15px rgba(0, 0, 0, 0.9);
    min-width: 17rem;
  }
  .notify__dot { width: 10px; height: 10px; margin-top: 0.45rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px rgba(34, 224, 122, 0.15); flex: none; }
  .notify__title { font-weight: 800; }
  .notify__text { color: var(--text-muted); font-size: var(--step--1); }
  .notify__meta { color: var(--accent); font-size: 0.75rem; margin-top: 0.35rem; }

  @media (min-width: 64rem) {
    .hero__grid { grid-template-columns: 1.05fr 1fr; }
    .hero__visual { order: 0; margin: 0; }
    .logo3d { height: clamp(20rem, 30vw, 27rem); }
    .notify { display: flex; }
  }
  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    .notify { animation: notify-in 0.7s 2.1s cubic-bezier(0.2, 0.9, 0.3, 1.3) backwards; }
  }
  @keyframes notify-in { from { opacity: 0; transform: translateY(14px) scale(0.92); } }
</style>
