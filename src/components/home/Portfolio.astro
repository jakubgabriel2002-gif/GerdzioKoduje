---
import { demos } from '../../config';
---
<section id="portfolio" class="section" aria-labelledby="portfolio-title">
  <div class="container">
    <div class="section-head">
      <h2 id="portfolio-title">Zobacz, jak to może wyglądać</h2>
      <p>Trzy kompletne strony pokazowe dla fikcyjnych lokalnych firm. Każda w innym stylu — strona ma pasować do Twojej branży, nie do mnie.</p>
    </div>
    <ul class="demos">
      {demos.map((d) => (
        <li>
          <a href={`/demo/${d.slug}`} class="demo-card">
            <span class="demo-card__media">
              <img src={d.image} width="800" height="500" loading="lazy" decoding="async" alt={`Podgląd strony pokazowej: ${d.name}`} />
              <span class="demo-card__label">DEMO · firma fikcyjna</span>
            </span>
            <span class="demo-card__meta">
              <span class="demo-card__name">{d.name}</span>
              <span class="demo-card__industry">{d.industry}</span>
            </span>
            <span class="demo-card__text">{d.text}</span>
            <span class="demo-card__cta">Otwórz demo <span aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .demos { list-style: none; padding: 0; display: grid; gap: 2.5rem 1.5rem; }
  .demo-card { display: grid; gap: 0.75rem; color: var(--text); text-decoration: none; }
  .demo-card__media {
    position: relative;
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-raised-2);
    margin-bottom: 0.4rem;
  }
  .demo-card img { width: 100%; aspect-ratio: 8 / 5; object-fit: cover; object-position: top; transition: transform 0.4s ease; }
  .demo-card:hover img { transform: scale(1.03); }
  .demo-card:hover .demo-card__media { border-color: var(--border-strong); }
  .demo-card__label {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: rgba(11, 11, 12, 0.88);
    color: var(--text);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .demo-card__meta { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.25rem 1rem; }
  .demo-card__name { font-weight: 800; font-size: var(--step-1); letter-spacing: -0.02em; }
  .demo-card__industry { color: var(--text-dim); font-size: var(--step--1); }
  .demo-card__text { color: var(--text-muted); }
  .demo-card__cta { font-weight: 800; }
  .demo-card__cta span { display: inline-block; color: var(--accent); transition: transform 0.18s; }
  .demo-card:hover .demo-card__cta span { transform: translateX(4px); }
  @media (min-width: 48rem) { .demos { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .demos { grid-template-columns: repeat(3, 1fr); } }
</style>
