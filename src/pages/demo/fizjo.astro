---
import '@fontsource/nunito/latin-400.css';
import '@fontsource/nunito/latin-ext-400.css';
import '@fontsource/nunito/latin-700.css';
import '@fontsource/nunito/latin-ext-700.css';
import '@fontsource/nunito/latin-800.css';
import '@fontsource/nunito/latin-ext-800.css';
import DemoLayout from '../../layouts/DemoLayout.astro';
import DemoForm from '../../components/demo/DemoForm.astro';
import DemoMap from '../../components/demo/DemoMap.astro';
import DemoHours from '../../components/demo/DemoHours.astro';

const services = [
  { name: 'Konsultacja fizjoterapeutyczna', time: '60 min', price: '180 zł', text: 'Wywiad, badanie funkcjonalne i plan terapii. Od tego zaczynamy.' },
  { name: 'Terapia manualna', time: '50 min', price: '170 zł', text: 'Praca na stawach i tkankach miękkich przy bólu kręgosłupa i stawów.' },
  { name: 'Masaż leczniczy', time: '45 min', price: '150 zł', text: 'Rozluźnienie napiętych mięśni, ulga przy przeciążeniach.' },
  { name: 'Rehabilitacja po urazach', time: '60 min', price: '180 zł', text: 'Powrót do sprawności po skręceniach, złamaniach i zabiegach.' },
  { name: 'Kinesiotaping', time: '20 min', price: '70 zł', text: 'Plastrowanie wspierające terapię i codzienną aktywność.' },
  { name: 'Wizyta domowa', time: '60 min', price: '250 zł', text: 'Dla osób, którym trudno dotrzeć do gabinetu.' },
];
const hours: [string, string][] = [
  ['Poniedziałek – czwartek', '8:00 – 20:00'],
  ['Piątek', '8:00 – 16:00'],
  ['Sobota', '9:00 – 13:00 (co drugą)'],
  ['Niedziela', 'zamknięte'],
];
const reviews = [
  { text: 'Po trzech wizytach przestał mnie budzić ból karku. Dostałam też ćwiczenia do domu, które naprawdę robię.', who: 'Joanna, 41 lat' },
  { text: 'Spokojna atmosfera, wszystko wytłumaczone. Wróciłem do biegania po kontuzji kolana.', who: 'Piotr, 35 lat' },
  { text: 'Wizyty domowe u mojej mamy po operacji biodra — ogromna pomoc.', who: 'Ewa, córka pacjentki' },
];
---
<DemoLayout
  title="Fizjo Równowaga — gabinet fizjoterapii (demo) | Gerdzio Koduje"
  description="Strona pokazowa fikcyjnego gabinetu fizjoterapii Fizjo Równowaga. Projekt: Gerdzio Koduje."
  themeColor="#f6f7f3"
  theme="fizjo"
>
  <header class="f-header">
    <div class="d-container f-header__in">
      <a href="#tresc" class="f-logo"><span class="f-logo__dot" aria-hidden="true"></span>Fizjo Równowaga</a>
      <nav aria-label="Menu gabinetu">
        <ul>
          <li><a href="#terapie">Terapie</a></li>
          <li><a href="#o-nas">O nas</a></li>
          <li><a href="#opinie">Opinie</a></li>
          <li><a href="#zapisy">Zapisy</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="tresc">
    <section class="f-hero">
      <div class="d-container f-hero__in">
        <div>
          <p class="f-pill">Gabinet fizjoterapii · Przykładowo</p>
          <h1>Wróć do ruchu bez bólu.</h1>
          <p class="f-lead">Szukamy przyczyny, a nie tylko gasimy objawy. Każdą terapię zaczynamy od rozmowy i badania — potem dostajesz jasny plan.</p>
          <div class="f-cta">
            <a class="f-btn" href="#zapisy">Umów pierwszą wizytę</a>
            <a class="f-btn f-btn--soft" href="#terapie">Zobacz terapie</a>
          </div>
        </div>
        <div class="f-hero__art" aria-hidden="true">
          <span class="f-blob f-blob--1"></span>
          <span class="f-blob f-blob--2"></span>
          <span class="f-blob f-blob--3"></span>
          <p class="f-hero__badge"><strong>1:1</strong> pełna godzina tylko dla Ciebie</p>
        </div>
      </div>
    </section>

    <section id="terapie" class="d-section">
      <div class="d-container">
        <p class="f-pill">Terapie i ceny</p>
        <h2>W czym pomagamy</h2>
        <ul class="f-services">
          {services.map((s) => (
            <li>
              <h3>{s.name}</h3>
              <p>{s.text}</p>
              <p class="f-services__meta"><span>{s.time}</span><strong>{s.price}</strong></p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="o-nas" class="d-section f-about">
      <div class="d-container f-about__in">
        <div>
          <p class="f-pill">O nas</p>
          <h2>Mały gabinet, dużo uwagi</h2>
          <p>W Fizjo Równowadze pracują dwie fizjoterapeutki. Przyjmujemy dorosłych i młodzież — z bólem pleców, po urazach sportowych, po zabiegach ortopedycznych i z przeciążeniami od pracy przy biurku.</p>
          <p>Nie sprzedajemy pakietów na zapas. Po każdej wizycie wiesz, co dalej i ile spotkań jest potrzebnych.</p>
        </div>
        <ul class="f-facts">
          <li><strong>60 min</strong><span>pierwsza wizyta</span></li>
          <li><strong>2</strong><span>fizjoterapeutki</span></li>
          <li><strong>parter</strong><span>bez schodów, parking</span></li>
        </ul>
      </div>
    </section>

    <section id="opinie" class="d-section">
      <div class="d-container">
        <p class="f-pill">Opinie · przykładowe</p>
        <h2>Pacjenci o nas</h2>
        <ul class="f-reviews">
          {reviews.map((r) => (
            <li>
              <blockquote><p>„{r.text}”</p></blockquote>
              <p class="f-reviews__who">{r.who}</p>
            </li>
          ))}
        </ul>
        <p class="f-note">Opinie przykładowe — gabinet jest fikcyjny.</p>
      </div>
    </section>

    <section id="zapisy" class="d-section f-contact">
      <div class="d-container f-contact__in">
        <div class="f-contact__info">
          <p class="f-pill">Zapisy</p>
          <h2>Umów wizytę</h2>
          <p>ul. Przykładowa 1, 00-000 Przykładowo<br />tel. <a href="tel:000000000">000 000 000</a> · kontakt@example.com</p>
          <h3>Godziny przyjęć</h3>
          <DemoHours hours={hours} caption="Godziny przyjęć" />
          <DemoMap address="ul. Przykładowa 1, 00-000 Przykładowo" />
        </div>
        <div class="f-card">
          <h3>Poproś o termin</h3>
          <DemoForm id="f" services={services.map((s) => s.name)} submitLabel="Wyślij prośbę o termin" />
        </div>
      </div>
    </section>
  </main>

  <footer class="f-footer">
    <div class="d-container">
      <p><strong>Fizjo Równowaga</strong> — gabinet fikcyjny, dane przykładowe.</p>
      <p>ul. Przykładowa 1, 00-000 Przykładowo · tel. 000 000 000</p>
    </div>
  </footer>
</DemoLayout>

<style is:global>
  .demo--fizjo {
    --d-bg: #f6f7f3;
    --d-text: #1f2d26;
    --d-muted: #52615a;
    --d-accent: #3e7357;
    --d-surface: #ffffff;
    --d-line: #dde3dc;
    --d-radius: 14px;
    --d-font-head: 'Nunito', system-ui, sans-serif;
    --d-font-body: 'Nunito', system-ui, sans-serif;
    --d-input-border: #9aa8a0;
    --d-status-bg: #e3efe6;
    --d-status-text: #1f4a33;
    --d-map-bg: #e8ece4;
    --d-map-block: #d7ddd2;
    --d-map-green: #c9dcc6;
  }
  .demo--fizjo h1, .demo--fizjo h2 { font-weight: 800; letter-spacing: -0.01em; }
  .demo--fizjo h2 { font-size: clamp(2rem, 1.5rem + 2vw, 2.9rem); margin-bottom: 2rem; }
  .demo--fizjo h3 { font-weight: 800; font-size: 1.2rem; }
  .f-pill { display: inline-block; padding: 0.3rem 0.85rem; background: #e3efe6; color: #24553b; border-radius: 999px; font-weight: 700; font-size: 0.85rem; margin-bottom: 1rem; }
  .f-note { color: var(--d-muted); font-size: 0.9rem; margin-top: 1.5rem; }

  .f-btn, .demo--fizjo .d-btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 3rem; padding: 0.7rem 1.5rem;
    background: var(--d-accent); color: #fff !important; border: 0; border-radius: 999px; font-weight: 700; text-decoration: none; cursor: pointer; justify-self: start;
  }
  .f-btn:hover, .demo--fizjo .d-btn:hover { background: #2f5c44; }
  .f-btn--soft { background: #e3efe6; color: #24553b !important; }
  .f-btn--soft:hover { background: #d3e6d8; }

  .f-header { background: var(--d-bg); }
  .f-header__in { display: flex; justify-content: space-between; align-items: center; min-height: 4.5rem; }
  .f-logo { display: inline-flex; align-items: center; gap: 0.6rem; font-weight: 800; font-size: 1.25rem; color: var(--d-text) !important; text-decoration: none; }
  .f-logo__dot { width: 1.4rem; height: 1.4rem; border-radius: 50%; background: var(--d-accent); box-shadow: 0.55rem 0 0 -0.15rem #b8d4bf; }
  .f-header nav { display: none; }
  .f-header nav ul { list-style: none; display: flex; gap: 0.5rem; padding: 0; }
  .f-header nav a { display: block; padding: 0.45rem 0.9rem; border-radius: 999px; color: var(--d-text); text-decoration: none; font-weight: 700; }
  .f-header nav a:hover { background: #e3efe6; }
  @media (min-width: 50rem) { .f-header nav { display: block; } }

  .f-hero { padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(3rem, 2rem + 4vw, 6rem); }
  .f-hero__in { display: grid; gap: 3rem; align-items: center; }
  .f-hero h1 { font-size: clamp(2.5rem, 1.7rem + 4vw, 4.4rem); }
  .f-lead { margin-top: 1.25rem; font-size: 1.15rem; color: var(--d-muted); max-width: 34rem; }
  .f-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .f-hero__art { position: relative; aspect-ratio: 1 / 0.85; max-width: 30rem; width: 100%; justify-self: center; }
  .f-blob { position: absolute; border-radius: 50%; }
  .f-blob--1 { inset: 5% 15% 10% 5%; background: #cfe3d4; border-radius: 58% 42% 50% 50% / 50% 55% 45% 50%; }
  .f-blob--2 { width: 42%; aspect-ratio: 1; right: 4%; top: 4%; background: #3e7357; }
  .f-blob--3 { width: 26%; aspect-ratio: 1; left: 10%; bottom: 2%; background: #f2d9b8; }
  .f-hero__badge { position: absolute; right: 2%; bottom: 14%; background: #fff; padding: 0.9rem 1.1rem; border-radius: 14px; box-shadow: 0 10px 30px rgba(31, 45, 38, 0.12); max-width: 13rem; font-size: 0.92rem; }
  .f-hero__badge strong { display: block; font-size: 1.6rem; color: var(--d-accent); }
  @media (min-width: 56rem) { .f-hero__in { grid-template-columns: 1.15fr 1fr; } }

  .f-services { list-style: none; padding: 0; display: grid; gap: 1rem; }
  .f-services li { background: var(--d-surface); border-radius: var(--d-radius); padding: 1.5rem; display: grid; gap: 0.6rem; box-shadow: 0 1px 2px rgba(31, 45, 38, 0.06); }
  .f-services li p { color: var(--d-muted); }
  .f-services__meta { display: flex; justify-content: space-between; align-items: baseline; margin-top: auto; padding-top: 0.75rem; border-top: 1px solid var(--d-line); }
  .f-services__meta strong { color: var(--d-text); font-size: 1.2rem; }
  @media (min-width: 40rem) { .f-services { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 64rem) { .f-services { grid-template-columns: repeat(3, 1fr); } }

  .f-about { background: #e9f1eb; }
  .f-about__in { display: grid; gap: 2.5rem; align-items: center; }
  .f-about__in p:not(.f-pill) { color: var(--d-muted); margin-top: 1rem; max-width: 38rem; font-size: 1.05rem; }
  .f-about h2 { margin-bottom: 0; }
  .f-facts { list-style: none; padding: 0; display: grid; gap: 1rem; }
  .f-facts li { background: #fff; border-radius: var(--d-radius); padding: 1.25rem 1.5rem; display: grid; }
  .f-facts strong { font-size: 1.8rem; font-weight: 800; color: var(--d-accent); }
  .f-facts span { color: var(--d-muted); }
  @media (min-width: 56rem) { .f-about__in { grid-template-columns: 1.4fr 1fr; } }

  .f-reviews { list-style: none; padding: 0; display: grid; gap: 1rem; }
  .f-reviews li { background: var(--d-surface); border-radius: var(--d-radius); padding: 1.5rem; display: grid; gap: 1rem; }
  .f-reviews blockquote p { font-size: 1.05rem; }
  .f-reviews__who { color: var(--d-accent); font-weight: 700; }
  @media (min-width: 52rem) { .f-reviews { grid-template-columns: repeat(3, 1fr); } }

  .f-contact__in { display: grid; gap: 2.5rem; }
  .f-contact__info { display: grid; gap: 1.25rem; align-content: start; }
  .f-contact__info h2 { margin-bottom: 0; }
  .f-card { background: var(--d-surface); border-radius: 20px; padding: clamp(1.25rem, 1rem + 1.5vw, 2.25rem); display: grid; gap: 1rem; align-self: start; box-shadow: 0 10px 30px rgba(31, 45, 38, 0.08); }
  @media (min-width: 60rem) { .f-contact__in { grid-template-columns: 1fr 1.2fr; } }

  .f-footer { background: #1f2d26; color: #cfdad3; padding-block: 2rem; font-size: 0.9rem; }
  .f-footer .d-container { display: grid; gap: 0.3rem; }
  .f-footer strong { color: #fff; }
</style>
