---
import LogoAnchor from '../LogoAnchor.astro';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <h1 id="hero-title">Strony dla firm, które same obsługują klientów.</h1>
      <p class="hero__lead">
        Robię strony dla lokalnych firm. Klient wypełnia formularz, od razu dostaje odpowiedź, a Ty masz zgłoszenie w arkuszu — bez odbierania telefonów w trakcie pracy.
      </p>
      <div class="hero__actions">
        <a class="btn" href="#kontakt">Wyceń stronę <span class="btn__arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--secondary" href="#portfolio">Zobacz przykłady</a>
      </div>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <LogoAnchor class="hero__logo" />
      <div class="notify">
        <span class="notify__dot"></span>
        <div>
          <p class="notify__title">Nowe zapytanie</p>
          <p class="notify__text">Manicure hybrydowy, sobota rano</p>
          <p class="notify__meta">zapisano w arkuszu · odpowiedź wysłana</p>
        </div>
      </div>
    </div>
  </div>

</section>

<style>
  .hero {
    position: relative;
    view-transition-name: vt-firm;
    padding-block: clamp(1.25rem, 0.25rem + 4.5vw, 6.5rem) clamp(3rem, 2rem + 4vw, 5rem);
  }
  /* siatka w tle wygasa ku dołowi (przezroczyście — spod spodu prześwituje logo 3D) */
  .hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 56px 56px;
    background-position: center top;
    mask-image: linear-gradient(to bottom, #000 40%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, #000 40%, transparent);
  }
  .hero > .container { position: relative; z-index: 1; }

  .hero__grid { display: grid; gap: clamp(2.5rem, 2rem + 3vw, 4rem); align-items: center; }
  .hero h1 { font-size: clamp(2.1rem, 1.5rem + 2.6vw, 3.6rem); line-height: 1.07; letter-spacing: -0.035em; max-width: 17ch; }
  .hero__lead { margin-top: 1.5rem; max-width: 36rem; color: var(--text-muted); font-size: var(--step-1); line-height: 1.6; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.25rem; }
  .hero__actions .btn { flex: 1 1 12rem; }
  @media (min-width: 40rem) { .hero__actions .btn { flex: 0 0 auto; } }

  .hero__visual { position: relative; order: -1; margin-block: -1rem -1.5rem; }
  /* miejsce startu logo 3D (tło strony: BgLogo) — mobile first: nad tytułem */
  :global(.hero__logo) { height: clamp(10.5rem, 46vw, 14rem); }
  .notify {
    position: absolute;
    left: -3rem;
    bottom: -3.25rem;
    display: none;
    gap: 0.8rem;
    align-items: flex-start;
    padding: 1rem 1.2rem;
    background: #141416;
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    box-shadow: 0 20px 50px -15px rgba(0, 0, 0, 0.9);
    min-width: 17rem;
  }
  .notify__dot { width: 10px; height: 10px; margin-top: 0.45rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px rgba(34, 224, 122, 0.15); flex: none; }
  .notify__title { font-weight: 800; }
  .notify__text { color: var(--text-muted); font-size: var(--step--1); }
  .notify__meta { color: var(--accent); font-size: 0.75rem; margin-top: 0.35rem; }

  @media (min-width: 64rem) {
    .hero__grid { grid-template-columns: 1.05fr 1fr; }
    .hero__visual { order: 0; margin: 0; }
    :global(.hero__logo) { height: clamp(20rem, 30vw, 27rem); }
    .notify { display: flex; }
  }
  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    .notify { animation: notify-in 0.7s 2.1s cubic-bezier(0.2, 0.9, 0.3, 1.3) backwards; }
  }
  @keyframes notify-in { from { opacity: 0; transform: translateY(14px) scale(0.92); } }
</style>
