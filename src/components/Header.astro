---
import Lockup from './Lockup.astro';
import { nav } from '../config';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Gerdzio Koduje — strona główna">
      <Lockup size="sm" />
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      hidden
    >
      <span class="menu-toggle__icon" aria-hidden="true"><span></span></span>
      <span class="menu-toggle__label">menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Główna nawigacja">
      <ul class="site-nav__list">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      <a href="/#kontakt" class="btn site-nav__cta">Wyceń stronę</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(11, 11, 12, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .site-header__inner {
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-block: 0.6rem;
  }
  .site-header__brand { text-decoration: none; display: inline-flex; padding-block: 0.25rem; }

  .site-nav { display: flex; flex-direction: column; gap: 1rem; width: 100%; padding-block: 0.5rem 1rem; }
  .site-nav__list { list-style: none; padding: 0; display: flex; flex-direction: column; }
  .site-nav__list a {
    display: block;
    padding: 0.7rem 0;
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }
  .site-nav__list a::before { content: '> '; color: var(--accent); opacity: 0; transition: opacity 0.15s; }
  .site-nav__list a:hover::before,
  .site-nav__list a[aria-current='page']::before { opacity: 1; }
  .site-nav__list a:hover { color: var(--accent); }

  /* Z JS: menu chowane za przyciskiem na mobile */
  :global(.js) .menu-toggle[hidden] { display: inline-flex; }
  :global(.js) .site-nav { display: none; }
  :global(.js) .site-nav.is-open { display: flex; }

  .menu-toggle {
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.8rem;
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .menu-toggle:hover { border-color: var(--accent); }
  .menu-toggle__icon, .menu-toggle__icon span,
  .menu-toggle__icon::before, .menu-toggle__icon::after { display: block; width: 18px; height: 2px; background: var(--accent); }
  .menu-toggle__icon { background: none; position: relative; height: 14px; display: flex; align-items: center; }
  .menu-toggle__icon::before, .menu-toggle__icon::after { content: ''; position: absolute; left: 0; transition: transform 0.2s; }
  .menu-toggle__icon::before { top: 0; }
  .menu-toggle__icon::after { bottom: 0; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon span { opacity: 0; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon::before { transform: translateY(6px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon::after { transform: translateY(-6px) rotate(-45deg); }

  @media (min-width: 60rem) {
    .site-header__inner { flex-wrap: nowrap; }
    .menu-toggle, :global(.js) .menu-toggle[hidden] { display: none; }
    .site-nav, :global(.js) .site-nav {
      display: flex;
      flex-direction: row;
      align-items: center;
      width: auto;
      padding: 0;
      gap: 1.75rem;
    }
    .site-nav__list { flex-direction: row; gap: 1.5rem; }
    .site-nav__list a { border: 0; padding: 0.5rem 0; font-size: var(--step--1); }
    .site-nav__cta { min-height: 2.5rem; padding: 0.5rem 1rem; font-size: var(--step--1); }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const navEl = document.getElementById('site-nav');
  if (toggle && navEl) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      navEl.classList.toggle('is-open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    navEl.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 60rem)').addEventListener('change', () => setOpen(false));
  }
</script>
