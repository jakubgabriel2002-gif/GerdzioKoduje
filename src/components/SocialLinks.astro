---
import { socialList } from '../config';
interface Props { class?: string }
---
<ul class:list={['social', Astro.props.class]}>
  {socialList.map((s) => (
    <li>
      <a href={s.href} target="_blank" rel="noopener me">
        {s.name}<span class="social__ext" aria-hidden="true">↗</span><span class="visually-hidden"> (otwiera się w nowej karcie)</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .social { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .social a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.6rem;
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    color: var(--text);
    text-decoration: none;
    font-size: var(--step--1);
    transition: border-color 0.15s, color 0.15s;
  }
  .social__ext { color: var(--text-dim); transition: color 0.15s; }
  .social a:hover { border-color: var(--accent); }
  .social a:hover .social__ext { color: var(--accent); }
</style>
