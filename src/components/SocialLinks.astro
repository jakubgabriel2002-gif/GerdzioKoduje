---
import { socialList } from '../config';
interface Props { class?: string }
---
<ul class:list={['social', Astro.props.class]}>
  {socialList.map((s) => (
    <li>
      <a href={s.href} target="_blank" rel="noopener me">
        {s.name.toLowerCase()}<span class="visually-hidden"> (otwiera się w nowej karcie)</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .social { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; }
  .social a {
    display: inline-block;
    padding-block: 0.35rem;
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--border-strong);
  }
  .social a::before { content: '@'; color: var(--accent); }
  .social a:hover { color: var(--accent); border-color: var(--accent); }
</style>
