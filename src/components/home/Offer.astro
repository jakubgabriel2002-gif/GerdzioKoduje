---
import { packages, formatPrice } from '../../config';
---
<section id="oferta" class="section" aria-labelledby="oferta-title">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">oferta dla firm</span>
      <h2 id="oferta-title">Pakiety</h2>
      <p>Ceny „od” — dokładną wycenę dostajesz po krótkim briefie. Bez ukrytych kosztów, domena zawsze na Ciebie.</p>
    </div>

    <ul class="packages">
      {packages.map((p) => (
        <li class:list={['pkg', { 'pkg--featured': p.featured }]}>
          {p.badge && <p class="pkg__badge">{p.badge}</p>}
          <h3 class="pkg__name">{p.name}</h3>
          <p class="pkg__price">
            <span class="pkg__from">od</span> <strong>{formatPrice(p.price)}</strong>{p.period && <span class="pkg__period">{p.period}</span>}
          </p>
          <p class="pkg__summary">{p.summary}</p>
          <ul class="prompt-list pkg__features">
            {p.features.map((f) => <li>{f}</li>)}
          </ul>
          <a href="#kontakt" class:list={['btn', { 'btn--ghost': !p.featured }]} data-package={p.inForm ? p.name : undefined}>
            Zapytaj o ten pakiet<span class="visually-hidden">: {p.name}</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="offer-note">
      Robię strony dla firm. Jeśli chcesz nauczyć się budować sam — zajrzyj do sekcji <a href="/nauka">Nauka</a>.
    </p>
  </div>
</section>

<style>
  .packages { list-style: none; padding: 0; display: grid; gap: var(--space-m); }
  .pkg {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-m);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .pkg--featured { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent) inset; }
  .pkg__badge {
    align-self: flex-start;
    padding: 0.2rem 0.6rem;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: var(--step--1);
    font-weight: 800;
    border-radius: 3px;
  }
  .pkg__name { font-size: var(--step-2); }
  .pkg__price { font-size: var(--step-1); }
  .pkg__price strong { font-size: var(--step-3); font-weight: 800; color: var(--accent); letter-spacing: -0.02em; }
  .pkg__from, .pkg__period { color: var(--text-muted); }
  .pkg__summary { color: var(--text-muted); }
  .pkg__features { margin-bottom: var(--space-s); }
  .pkg .btn { margin-top: auto; }
  .offer-note {
    margin-top: var(--space-l);
    padding: var(--space-s) var(--space-m);
    border-left: 2px solid var(--accent);
    color: var(--text-muted);
    max-width: 46rem;
  }
  @media (min-width: 60rem) {
    .packages { grid-template-columns: repeat(3, 1fr); align-items: stretch; }
  }
</style>
