---
/**
 * Miejsce na widget Cloudflare Turnstile (antyspam). Widget wstawia skrypt
 * src/scripts/turnstile.ts — klucz pobiera z /api/turnstile-key (zmienna
 * TURNSTILE_SITE_KEY w Cloudflare). Bez klucza nic się nie wyświetla.
 */
import { turnstileSiteKey } from '../../config';
---
<div class="ts-slot" data-sitekey={turnstileSiteKey || undefined}></div>

<style>
  .ts-slot:empty { display: none; }
  .ts-slot { min-height: 65px; }
</style>
