---
import { processSteps, processNote } from '../../config';
---
<section id="proces" class="section" aria-labelledby="proces-title">
  <div class="container">
    <div class="section-head">
      <h2 id="proces-title">Jak pracujemy</h2>
    </div>
    <ol class="steps">
      {processSteps.map((s, i) => (
        <li class="step">
          <span class="step__no" aria-hidden="true">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
    <p class="process-note">{processNote}</p>
  </div>
</section>

<style>
  .steps { list-style: none; padding: 0; display: grid; gap: 2rem; }
  .step { position: relative; display: grid; gap: 0.6rem; align-content: start; }
  .step__no {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.5rem;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--accent-line);
    color: var(--accent);
    font-weight: 800;
    position: relative;
    z-index: 1;
  }
  .step p { color: var(--text-muted); }
  .process-note {
    margin-top: 3rem;
    padding: 1.25rem 1.5rem;
    max-width: 52rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    color: var(--text-muted);
  }
  @media (min-width: 48rem) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) {
    .steps { grid-template-columns: repeat(4, 1fr); gap: 2.5rem; }
    /* linia łącząca kroki */
    .step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 1.375rem;
      left: 3.25rem;
      right: -2rem;
      height: 1px;
      background: var(--border-strong);
    }
  }
</style>
