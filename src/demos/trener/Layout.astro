---
import '@fontsource/anton/latin-400.css';
import '@fontsource/anton/latin-ext-400.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-ext-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-ext-600.css';
import './theme.css';
import DemoLayout from '../../layouts/DemoLayout.astro';
import DemoHeader from '../../components/demo/DemoHeader.astro';
import { demos, demoUrl, demoPackage, type DemoVersion } from '../../config';

interface Props { version: DemoVersion; page?: string; title: string }
const { version, page = '', title } = Astro.props;
const firm = demos.find((d) => d.slug === 'trener')!;
const links =
  version === 'firmowa'
    ? firm.pages.map((p) => ({ label: p.label, href: demoUrl(firm.slug, 'firmowa', p.path), current: p.path === page }))
    : [{ label: 'O mnie', href: '#o-nas' }, { label: 'Cennik', href: '#uslugi' }, { label: 'Kontakt', href: '#kontakt' }];
const cta = version === 'firmowa'
  ? { label: 'Trening próbny', href: demoUrl(firm.slug, 'firmowa', 'zapisy') }
  : { label: 'Zadzwoń', href: 'tel:000000000' };
---
<DemoLayout
  title={`${title} — ${firm.name} (demo: ${demoPackage(version).name}) | Gerdzio Koduje`}
  description={`Strona pokazowa fikcyjnego trenera personalnego ${firm.name} w pakiecie ${demoPackage(version).name}. Projekt: Gerdzio Koduje.`}
  themeColor="#0f1012"
  theme="trener"
  firm={firm.slug}
  version={version}
>
  <DemoHeader links={links} cta={cta} brandHref={demoUrl(firm.slug, version)}>
    <span slot="brand" class="t-logo"><span class="t-logo__mark" aria-hidden="true"></span>Forma Od Podstaw</span>
  </DemoHeader>
  <main id="tresc"><slot /></main>
  <footer class="t-footer">
    <div class="d-container">
      <p class="t-logo"><span class="t-logo__mark" aria-hidden="true"></span>Forma Od Podstaw</p>
      {version === 'firmowa' && (
        <ul class="t-footer__links">
          {firm.pages.map((p) => <li><a href={demoUrl(firm.slug, 'firmowa', p.path)}>{p.label}</a></li>)}
        </ul>
      )}
      <p>Trener fikcyjny · dane przykładowe · ul. Przykładowa 1, 00-000 Przykładowo · tel. 000 000 000</p>
    </div>
  </footer>
</DemoLayout>
