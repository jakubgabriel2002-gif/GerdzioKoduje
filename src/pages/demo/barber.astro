---
import '@fontsource/playfair-display/latin-700.css';
import '@fontsource/playfair-display/latin-ext-700.css';
import '@fontsource/playfair-display/latin-600-italic.css';
import '@fontsource/playfair-display/latin-ext-600-italic.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-ext-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-ext-600.css';
import DemoLayout from '../../layouts/DemoLayout.astro';
import DemoForm from '../../components/demo/DemoForm.astro';
import DemoMap from '../../components/demo/DemoMap.astro';
import DemoHours from '../../components/demo/DemoHours.astro';

const menu = [
  { group: 'Włosy', items: [
    { name: 'Strzyżenie klasyczne', time: '45 min', price: '70 zł' },
    { name: 'Strzyżenie fade', time: '50 min', price: '80 zł' },
    { name: 'Strzyżenie maszynką', time: '25 min', price: '45 zł' },
    { name: 'Strzyżenie dziecięce (do 12 lat)', time: '30 min', price: '50 zł' },
  ]},
  { group: 'Broda', items: [
    { name: 'Trymowanie i konturowanie brody', time: '30 min', price: '50 zł' },
    { name: 'Golenie brzytwą z gorącym ręcznikiem', time: '40 min', price: '70 zł' },
    { name: 'Combo: włosy + broda', time: '75 min', price: '110 zł' },
  ]},
];
const hours: [string, string][] = [
  ['Poniedziałek', 'zamknięte'],
  ['Wtorek – piątek', '10:00 – 20:00'],
  ['Sobota', '9:00 – 15:00'],
  ['Niedziela', 'zamknięte'],
];
const reviews = [
  { text: 'Najlepszy fade, jaki miałem. Kawa, spokojna muzyka i zero pośpiechu.', who: 'Kuba' },
  { text: 'Golenie brzytwą to rytuał. Wychodzę jak nowy.', who: 'Paweł' },
  { text: 'Synek wreszcie lubi chodzić do fryzjera. Cierpliwość barberów — 10/10.', who: 'Ola, mama Antka' },
];
const services = menu.flatMap((g) => g.items.map((i) => i.name));
---
<DemoLayout
  title="Brzytwa & Grzebień — barber shop (demo) | Gerdzio Koduje"
  description="Strona pokazowa fikcyjnego barber shopu Brzytwa & Grzebień. Projekt: Gerdzio Koduje."
  themeColor="#141210"
  theme="barber"
>
  <header class="b-header">
    <div class="d-container b-header__in">
      <a href="#tresc" class="b-logo">Brzytwa <em>&amp;</em> Grzebień</a>
      <nav aria-label="Menu barbera">
        <ul>
          <li><a href="#cennik">Cennik</a></li>
          <li><a href="#o-nas">O nas</a></li>
          <li><a href="#opinie">Opinie</a></li>
          <li><a href="#rezerwacja">Rezerwacja</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="tresc">
    <section class="b-hero">
      <div class="d-container b-hero__in">
        <p class="b-eyebrow">Barber shop · Przykładowo</p>
        <h1>Klasyczne strzyżenie.<br /><em>Bez pośpiechu.</em></h1>
        <p class="b-lead">Męskie strzyżenia, broda i golenie brzytwą w kameralnym zakładzie na trzy fotele.</p>
        <div class="b-cta">
          <a class="b-btn" href="#rezerwacja">Zarezerwuj wizytę</a>
          <a class="b-link" href="#cennik">Zobacz cennik</a>
        </div>
      </div>
      <div class="b-ornament" aria-hidden="true"><span></span>✦<span></span></div>
    </section>

    <section id="cennik" class="d-section">
      <div class="d-container b-narrow">
        <p class="b-eyebrow">Cennik</p>
        <h2>Usługi</h2>
        {menu.map((g) => (
          <div class="b-menu">
            <h3>{g.group}</h3>
            <ul>
              {g.items.map((i) => (
                <li>
                  <span class="b-menu__name">{i.name} <small>{i.time}</small></span>
                  <span class="b-menu__dots" aria-hidden="true"></span>
                  <span class="b-menu__price">{i.price}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section id="o-nas" class="d-section b-about">
      <div class="d-container b-about__in">
        <div class="b-about__frame" aria-hidden="true">
          <span>B<em>&amp;</em>G</span>
          <small>est. 2016</small>
        </div>
        <div>
          <p class="b-eyebrow">O nas</p>
          <h2>Trzy fotele, dużo rozmów</h2>
          <p>Nie jesteśmy salonem na taśmę. Na każdą wizytę mamy zarezerwowany pełny czas, więc nikt nie patrzy na zegarek. Pracujemy na kosmetykach, które sami lubimy — i chętnie doradzimy, jak dbać o brodę między wizytami.</p>
          <p>Przyjmujemy po wcześniejszej rezerwacji, ale jeśli fotel jest wolny — wpadnij śmiało.</p>
        </div>
      </div>
    </section>

    <section id="opinie" class="d-section">
      <div class="d-container">
        <p class="b-eyebrow">Opinie <span class="b-tag">przykładowe</span></p>
        <h2>Słowo od klientów</h2>
        <ul class="b-reviews">
          {reviews.map((r) => (
            <li>
              <blockquote><p>„{r.text}”</p></blockquote>
              <p class="b-reviews__who">{r.who}</p>
            </li>
          ))}
        </ul>
        <p class="b-note">Opinie przykładowe — firma jest fikcyjna.</p>
      </div>
    </section>

    <section id="rezerwacja" class="d-section b-contact">
      <div class="d-container b-contact__in">
        <div class="b-contact__info">
          <p class="b-eyebrow">Rezerwacja</p>
          <h2>Umów się</h2>
          <p>ul. Przykładowa 1, 00-000 Przykładowo<br />tel. <a href="tel:000000000">000 000 000</a><br />kontakt@example.com</p>
          <h3>Godziny otwarcia</h3>
          <DemoHours hours={hours} />
          <DemoMap address="ul. Przykładowa 1, 00-000 Przykładowo" />
        </div>
        <div class="b-card">
          <h3>Zapytaj o termin</h3>
          <DemoForm id="b" services={services} submitLabel="Poproś o termin" />
        </div>
      </div>
    </section>
  </main>

  <footer class="b-footer">
    <div class="d-container">
      <p class="b-logo">Brzytwa <em>&amp;</em> Grzebień</p>
      <p>Firma fikcyjna · dane przykładowe · ul. Przykładowa 1, 00-000 Przykładowo</p>
    </div>
  </footer>
</DemoLayout>

<style is:global>
  .demo--barber {
    --d-bg: #141210;
    --d-text: #efe7da;
    --d-muted: #b3a998;
    --d-accent: #c9a24a;
    --d-link: #d9b766;
    --d-surface: #1d1a17;
    --d-line: #3a342d;
    --d-radius: 0;
    --d-font-head: 'Playfair Display', Georgia, serif;
    --d-font-body: 'Inter', system-ui, sans-serif;
    --d-input-bg: #100e0c;
    --d-input-text: #efe7da;
    --d-input-border: #6b6155;
    --d-status-bg: #2b2418;
    --d-status-text: #f0d999;
    --d-map-bg: #26221e;
    --d-map-road: #3d3730;
    --d-map-block: #312c27;
    --d-map-green: #2b2f25;
  }
  .demo--barber h2 { font-size: clamp(2.1rem, 1.6rem + 2vw, 3.2rem); font-weight: 700; margin-bottom: 1.5rem; }
  .demo--barber h3 { font-family: var(--d-font-head); font-weight: 700; font-size: 1.4rem; }
  .demo--barber em { font-style: italic; font-weight: 600; color: var(--d-accent); }
  .b-narrow { max-width: 46rem; }
  .b-eyebrow { text-transform: uppercase; letter-spacing: 0.25em; font-size: 0.78rem; color: var(--d-accent); margin-bottom: 0.75rem; font-weight: 600; }
  .b-tag { letter-spacing: 0.05em; text-transform: none; border: 1px solid var(--d-accent); padding: 0.1rem 0.45rem; margin-left: 0.5rem; }
  .b-note { color: var(--d-muted); font-size: 0.88rem; margin-top: 1.5rem; }

  .b-header { border-bottom: 1px solid var(--d-line); }
  .b-header__in { display: flex; justify-content: space-between; align-items: center; min-height: 4.25rem; gap: 1rem; }
  .b-logo { font-family: var(--d-font-head); font-weight: 700; font-size: 1.35rem; color: var(--d-text) !important; text-decoration: none; }
  .b-header nav { display: none; }
  .b-header nav ul { list-style: none; display: flex; gap: 2rem; padding: 0; }
  .b-header nav a { color: var(--d-text); text-decoration: none; text-transform: uppercase; letter-spacing: 0.15em; font-size: 0.78rem; }
  .b-header nav a:hover { color: var(--d-accent); }
  @media (min-width: 50rem) { .b-header nav { display: block; } }

  .b-hero { text-align: center; padding-block: clamp(4rem, 3rem + 6vw, 8rem) 3rem; border-bottom: 1px solid var(--d-line); }
  .b-hero__in { display: grid; justify-items: center; }
  .b-hero h1 { font-size: clamp(2.5rem, 1.7rem + 4.2vw, 5rem); font-weight: 700; }
  .b-lead { margin-top: 1.5rem; max-width: 32rem; color: var(--d-muted); font-size: 1.1rem; }
  .b-cta { display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; justify-content: center; margin-top: 2.25rem; }
  .b-btn, .demo--barber .d-btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 3rem; padding: 0.75rem 1.75rem;
    background: var(--d-accent); color: #141210 !important; border: 1px solid var(--d-accent);
    text-transform: uppercase; letter-spacing: 0.18em; font-size: 0.8rem; font-weight: 600; text-decoration: none; cursor: pointer; justify-self: start;
  }
  .b-btn:hover, .demo--barber .d-btn:hover { background: transparent; color: var(--d-accent) !important; }
  .b-link { color: var(--d-text) !important; text-transform: uppercase; letter-spacing: 0.18em; font-size: 0.8rem; padding-block: 0.6rem; }
  .b-ornament { display: flex; align-items: center; justify-content: center; gap: 1rem; color: var(--d-accent); margin-top: 3.5rem; }
  .b-ornament span { width: 4rem; height: 1px; background: var(--d-accent); }

  .b-menu + .b-menu { margin-top: 2.5rem; }
  .b-menu h3 { color: var(--d-accent); font-style: italic; font-weight: 600; margin-bottom: 0.75rem; }
  .b-menu ul { list-style: none; padding: 0; display: grid; gap: 0.9rem; }
  .b-menu li { display: flex; align-items: baseline; gap: 0.6rem; }
  .b-menu__name small { display: block; color: var(--d-muted); font-size: 0.82rem; }
  .b-menu__dots { flex: 1; border-bottom: 1px dotted #6b6155; transform: translateY(-0.3rem); min-width: 1rem; }
  .b-menu__price { font-family: var(--d-font-head); font-weight: 700; font-size: 1.2rem; white-space: nowrap; }

  .b-about { background: var(--d-surface); border-block: 1px solid var(--d-line); }
  .b-about__in { display: grid; gap: 2.5rem; align-items: center; }
  .b-about__in p:not(.b-eyebrow) { color: var(--d-muted); margin-top: 1rem; max-width: 36rem; }
  .b-about__frame { aspect-ratio: 1; max-width: 22rem; width: 100%; justify-self: center; display: grid; place-content: center; text-align: center; border: 1px solid var(--d-accent); outline: 1px solid var(--d-accent); outline-offset: -12px; }
  .b-about__frame span { font-family: var(--d-font-head); font-size: clamp(3.5rem, 2.5rem + 4vw, 5.5rem); font-weight: 700; }
  .b-about__frame small { text-transform: uppercase; letter-spacing: 0.3em; color: var(--d-muted); }
  @media (min-width: 50rem) { .b-about__in { grid-template-columns: 1fr 1.3fr; } }

  .b-reviews { list-style: none; padding: 0; display: grid; gap: 2rem; }
  .b-reviews blockquote p { font-family: var(--d-font-head); font-style: italic; font-weight: 600; font-size: 1.3rem; line-height: 1.4; }
  .b-reviews__who { margin-top: 0.75rem; color: var(--d-accent); text-transform: uppercase; letter-spacing: 0.18em; font-size: 0.78rem; }
  .b-reviews li { padding-left: 1.25rem; border-left: 1px solid var(--d-accent); }
  @media (min-width: 52rem) { .b-reviews { grid-template-columns: repeat(3, 1fr); } }

  .b-contact { border-top: 1px solid var(--d-line); }
  .b-contact__in { display: grid; gap: 2.5rem; }
  .b-contact__info { display: grid; gap: 1.25rem; align-content: start; }
  .b-contact__info h2 { margin-bottom: 0; }
  .b-card { background: var(--d-surface); border: 1px solid var(--d-line); padding: clamp(1.25rem, 1rem + 1.5vw, 2rem); display: grid; gap: 1rem; align-self: start; }
  @media (min-width: 60rem) { .b-contact__in { grid-template-columns: 1fr 1.2fr; } }

  .b-footer { border-top: 1px solid var(--d-line); padding-block: 2.5rem; text-align: center; color: var(--d-muted); font-size: 0.88rem; }
  .b-footer .d-container { display: grid; gap: 0.5rem; justify-items: center; }
</style>
