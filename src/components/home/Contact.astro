---
import LeadForm from '../forms/LeadForm.astro';
import EmailLink from '../EmailLink.astro';
---
<section id="kontakt" class="section" aria-labelledby="kontakt-title">
  <div class="container contact">
    <div class="contact__intro">
      <h2 id="kontakt-title">Wyceń stronę</h2>
      <p>Opisz krótko firmę i czego potrzebujesz. Odpowiadam z konkretną propozycją, nie z ogólnikami.</p>
      <ul class="check-list contact__list">
        <li>odpowiedź w ciągu 24 h</li>
        <li>makieta w 1–2 dni od briefu</li>
        <li>domena zawsze rejestrowana na Ciebie</li>
      </ul>
      <p class="contact__mail">Wolisz maila? <EmailLink subject="Zapytanie o stronę" /></p>
    </div>
    <div class="form-card">
      <LeadForm />
    </div>
  </div>
</section>

<script>
  /**
   * Linki do #kontakt (np. „Wyceń stronę”, „Zapytaj o pakiet”) przewijają prosto do ankiety,
   * a nie do nagłówka sekcji, i od razu odpalają jej animację wejścia (bez czekania na przewinięcie).
   */
  const card = document.querySelector<HTMLElement>('#kontakt .form-card');
  if (card) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const root = document.documentElement;
    const targetY = () => {
      // pozycja bez przesunięcia z animacji wejścia (translateY), minus wysokość nagłówka
      const ty = new DOMMatrixReadOnly(getComputedStyle(card).transform).m42 || 0;
      const pad = parseFloat(getComputedStyle(root).scrollPaddingTop) || 0;
      return Math.max(0, card.getBoundingClientRect().top + window.scrollY - ty - pad);
    };
    let placed = -1;
    const go = (smooth: boolean) => {
      document.querySelectorAll('#kontakt [data-reveal]').forEach((el) => el.classList.add('is-in'));
      placed = targetY();
      window.scrollTo({ top: placed, behavior: (smooth && !reduce ? 'smooth' : 'instant') as ScrollBehavior });
    };
    const samePage = (url: URL) => url.pathname.replace(/\/$/, '') === location.pathname.replace(/\/$/, '');
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const a = (e.target as Element).closest?.<HTMLAnchorElement>('a[href]');
      if (!a) return;
      const url = new URL(a.href, location.href);
      if (url.hash !== '#kontakt' || !samePage(url)) return;
      e.preventDefault();
      if (location.hash !== '#kontakt') history.pushState(null, '', '#kontakt');
      go(true);
    });
    // Wejście z innej strony (np. /dla-firm#kontakt z menu albo z dema).
    if (location.hash === '#kontakt') {
      requestAnimationFrame(() => go(false));
      window.addEventListener('load', () => {
        if (Math.abs(window.scrollY - placed) < 60) go(false); // korekta po doładowaniu fontów/obrazków
      }, { once: true });
    }
  }
</script>

<style>
  .contact { display: grid; gap: 2.5rem; }
  .contact__intro { display: grid; gap: 1.25rem; align-content: start; }
  .contact__intro > p { color: var(--text-muted); font-size: var(--step-1); line-height: 1.6; }
  .contact__mail { font-size: var(--step-0) !important; }
  @media (min-width: 64rem) {
    .contact { grid-template-columns: 1fr 1.45fr; gap: 4rem; }
    .contact__intro { position: sticky; top: calc(var(--header-h) + 2rem); }
  }
</style>
