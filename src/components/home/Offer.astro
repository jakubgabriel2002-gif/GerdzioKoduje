---
import { packages, formatPrice } from '../../config';
---
<section id="oferta" class="section" aria-labelledby="oferta-title">
  <div class="container">
    <div class="section-head">
      <h2 id="oferta-title">Oferta dla firm</h2>
      <p>Ceny „od” — dokładną wycenę dostajesz po krótkim briefie. Domena zawsze rejestrowana na Ciebie.</p>
    </div>

    <ul class="packages">
      {packages.map((p) => (
        <li class:list={['pkg', { 'pkg--featured': p.featured }]}>
          <div class="pkg__top">
            <h3 class="pkg__name">{p.name}</h3>
            {p.badge && <p class="pkg__badge">{p.badge}</p>}
          </div>
          <p class="pkg__price">
            <span class="pkg__from">od</span>
            <strong>{formatPrice(p.price)}</strong>
            {p.period && <span class="pkg__period">{p.period}</span>}
          </p>
          <p class="pkg__summary">{p.summary}</p>
          <ul class="check-list pkg__features">
            {p.features.map((f) => <li>{f}</li>)}
          </ul>
          <a href="#kontakt" class:list={['btn', 'btn--block', { 'btn--secondary': !p.featured }]} data-package={p.inForm ? p.name : undefined}>
            Zapytaj o ten pakiet<span class="visually-hidden">: {p.name}</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="offer-note">
      Robię strony dla firm. Jeśli chcesz nauczyć się budować sam — zajrzyj do sekcji <a href="/nauka">Nauka</a>.
    </p>
  </div>
</section>

<style>
  .packages { list-style: none; padding: 0; display: grid; gap: 1.25rem; }
  .pkg {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .pkg--featured { background: var(--accent-tint); border-color: var(--accent-line); }
  .pkg__top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; }
  .pkg__name { font-size: var(--step-1); }
  .pkg__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: rgba(34, 224, 122, 0.12);
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 800;
  }
  .pkg__badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .pkg__price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; }
  .pkg__price strong { font-size: clamp(2rem, 1.6rem + 1.6vw, 2.75rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1; }
  .pkg__from, .pkg__period { color: var(--text-muted); }
  .pkg__summary { color: var(--text-muted); padding-bottom: 1.1rem; border-bottom: 1px solid var(--border); }
  .pkg--featured .pkg__summary { border-color: var(--accent-line); }
  .pkg__features { margin-bottom: 0.75rem; }
  .pkg .btn { margin-top: auto; }
  .offer-note { margin-top: 2.5rem; color: var(--text-muted); max-width: 46rem; }
  @media (min-width: 60rem) {
    .packages { grid-template-columns: repeat(3, 1fr); }
  }
</style>
